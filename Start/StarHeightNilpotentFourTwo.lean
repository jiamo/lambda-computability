import Start.StarHeightNilpotentFour
import Start.StarHeightElementary

/-!
# Two letters modulo 2, saturation, and the Frattini corollary

* `GoodCount.of_mul_eq`: if `m * f = g` with `m > 0` and `g` good, then `f` is good.
* `GoodCount.choose`: `C(g, i)` is good when `g` is.
* `height_one_two_letters_length_four_mod_two`: every word `w` of length four over two distinct
  letters `x, y`, except `xxyy` and `yyxx`, has `L(w, k, 2)` of height at most one.  The new
  words are `xyxy`, `xyyx` and their letter swaps, from the identities (exact in `ℕ`)

    `C(scount [x,y] u, 2) = 2 xxyy + xyxy + xxy + xyy`                    (`choose_scount_xy`)
    `|u|_x · scount [x,y,y] u = 2 xxyy + xyxy + xyyx + xyy`               (`count_mul_scount_xyy`)

* `goodMod_xxyy_iff`: `xxyy` and `yyxx` are good modulo `n` together, from

    `xxyy + yyxx + xyy + yxx + C(|u|_x, 2) C(|u|_y, 2) = |u|_x · xyy + |u|_y · yxx`
                                                                        (`scount_xxyy_add_yyxx`).

* `height_one_of_frattini_abelian`: if the subgroup generated by all commutators and all `p`-th
  powers of a finite group `G` is abelian, every language recognized by `G` has height at most
  one.
-/

namespace GeneralizedStarHeight

universe u

section Saturation

variable {α : Type u}

/-- **Saturation.** A count that is `m` times a good count is good. -/
lemma GoodCount.of_mul_eq {f g : List α → ℕ} {m : ℕ} (hm : 0 < m) (hg : GoodCount g)
    (h : ∀ u, m * f u = g u) : GoodCount f := by
  apply goodCount_of_det.{u, 0}
  intro n hn
  refine ⟨Unit, inferInstance, fun _ => g, m * n, Nat.mul_pos hm hn, fun _ => hg, ?_⟩
  intro u w huw
  have h1 : m * f u ≡ m * f w [MOD m * n] := by rw [h u, h w]; exact huw ()
  exact (ZMod.natCast_eq_natCast_iff' _ _ n).mpr (Nat.ModEq.mul_left_cancel' hm.ne' h1)

/-- `C(g, i)` is good when `g` is: modulo `n` it depends only on `g` modulo `n · i!`. -/
lemma GoodCount.choose {g : List α → ℕ} (hg : GoodCount g) (i : ℕ) :
    GoodCount (fun u => (g u).choose i) := by
  apply goodCount_of_det.{u, 0}
  intro n hn
  refine ⟨Unit, inferInstance, fun _ => g, n * i.factorial, by positivity, fun _ => hg, ?_⟩
  intro u w huw
  show ((g u).choose i : ZMod n) = ((g w).choose i : ZMod n)
  rw [choose_cast_mod (N := n * i.factorial) dvd_rfl, huw (),
    ← choose_cast_mod (N := n * i.factorial) dvd_rfl]

end Saturation

/-! ### Identities for two letters -/

section Identities

variable {α : Type u} [DecidableEq α]

/-- `C(scount [x, y] u, 2) = 2 xxyy + xyxy + xxy + xyy`. -/
lemma choose_scount_xy {x y : α} (hxy : x ≠ y) (u : List α) :
    (scount [x, y] u).choose 2 =
      2 * scount [x, x, y, y] u + scount [x, y, x, y] u + scount [x, x, y] u + scount [x, y, y] u := by
  have h1 := scount_xy_sq hxy u
  have h2 := two_mul_choose_two_add (scount [x, y] u)
  omega

/-- `|u|_x · |u|_y = xy + yx`, for `x ≠ y`. -/
lemma count_mul_count_eq {x y : α} (hxy : x ≠ y) (u : List α) :
    u.count x * u.count y = scount [x, y] u + scount [y, x] u :=
  (scount_pair_swap hxy u).symm

/-- `|u|_x · scount [y, y] u = xyy + yxy + yyx`. -/
lemma count_mul_scount_yy {x y : α} (hxy : x ≠ y) :
    ∀ u : List α, u.count x * scount [y, y] u =
      scount [x, y, y] u + scount [y, x, y] u + scount [y, y, x] u
  | [] => rfl
  | z :: u => by
      have ih := count_mul_scount_yy hxy u
      have hl := count_mul_count_eq hxy u
      simp only [scount_cons_cons, scount_singleton, count_cons_eq]
      by_cases hzx : z = x
      · subst hzx
        simp only [ite_true, ite_eq_right hxy, add_zero]
        nlinarith
      · by_cases hzy : z = y
        · subst hzy
          simp only [ite_true, ite_eq_right hzx, add_zero]
          nlinarith
        · simp only [ite_eq_right hzx, ite_eq_right hzy, add_zero]
          exact ih

/-- `|u|_x · scount [x, y, y] u = 2 xxyy + xyxy + xyyx + xyy`. -/
lemma count_mul_scount_xyy {x y : α} (hxy : x ≠ y) :
    ∀ u : List α, u.count x * scount [x, y, y] u =
      2 * scount [x, x, y, y] u + scount [x, y, x, y] u + scount [x, y, y, x] u +
        scount [x, y, y] u
  | [] => rfl
  | z :: u => by
      have ih := count_mul_scount_xyy hxy u
      have hl := count_mul_scount_yy hxy u
      simp only [scount_cons_cons, count_cons_eq]
      by_cases hzx : z = x
      · subst hzx
        simp only [ite_true]
        nlinarith
      · by_cases hzy : z = y
        · subst hzy
          simp only [ite_eq_right hzx, add_zero]
          exact ih
        · simp only [ite_eq_right hzx, add_zero]
          exact ih

/-- `xxyy + yyxx + xyy + yxx + C(|u|_x, 2) C(|u|_y, 2) = |u|_x · xyy + |u|_y · yxx`. -/
lemma scount_xxyy_add_yyxx {x y : α} (hxy : x ≠ y) :
    ∀ u : List α, scount [x, x, y, y] u + scount [y, y, x, x] u + scount [x, y, y] u +
      scount [y, x, x] u + (u.count x).choose 2 * (u.count y).choose 2 =
        u.count x * scount [x, y, y] u + u.count y * scount [y, x, x] u
  | [] => rfl
  | z :: u => by
      have ih := scount_xxyy_add_yyxx hxy u
      have hxx := scount_replicate x 2 u
      have hyy := scount_replicate y 2 u
      simp only [List.replicate] at hxx hyy
      simp only [scount_cons_cons, count_cons_eq]
      by_cases hzx : z = x
      · subst hzx
        simp only [ite_true, ite_eq_right hxy, add_zero, Nat.choose_succ_succ', Nat.choose_one_right]
        rw [← hyy]
        nlinarith
      · by_cases hzy : z = y
        · subst hzy
          simp only [ite_true, ite_eq_right hzx, add_zero, Nat.choose_succ_succ', Nat.choose_one_right]
          rw [← hxx]
          nlinarith
        · simp only [ite_eq_right hzx, ite_eq_right hzy, add_zero]
          exact ih

end Identities

/-! ### Two letters modulo 2 -/

section ModTwo

variable {α : Type u} [DecidableEq α] [Finite α]

lemma two_eq_zero_zmod_two : (2 : ZMod 2) = 0 := rfl

lemma goodMod_xyxy_two {x y : α} (hxy : x ≠ y) : GoodMod 2 (scount [x, y, x, y]) := by
  refine goodMod_of_det (by norm_num)
    ![fun u => (scount [x, y] u).choose 2, scount [x, x, y], scount [x, y, y]] ?_ ?_
  · intro i
    fin_cases i
    · exact ((goodCount_scount_le_three [x, y] (by simp)).choose 2).goodMod 2
    · exact (goodCount_scount_le_three _ (by simp)).goodMod 2
    · exact (goodCount_scount_le_three _ (by simp)).goodMod 2
  · intro u w h
    have h0 := h 0; have h1 := h 1; have h2 := h 2
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] at h0 h1 h2
    have eu := congrArg (fun n : ℕ => (n : ZMod 2)) (choose_scount_xy hxy u)
    have ew := congrArg (fun n : ℕ => (n : ZMod 2)) (choose_scount_xy hxy w)
    push_cast at eu ew
    linear_combination ew - eu + h0 - h1 - h2 +
      ((scount [x, x, y, y] w : ZMod 2) - scount [x, x, y, y] u) * two_eq_zero_zmod_two

lemma goodMod_xyyx_two {x y : α} (hxy : x ≠ y) : GoodMod 2 (scount [x, y, y, x]) := by
  refine goodMod_of_det (by norm_num)
    ![fun u => u.count x, scount [x, y, y], scount [x, y, x, y]] ?_ ?_
  · intro i
    fin_cases i
    · exact (goodCount_count x).goodMod 2
    · exact (goodCount_scount_le_three _ (by simp)).goodMod 2
    · exact goodMod_xyxy_two hxy
  · intro u w h
    have h0 := h 0; have h1 := h 1; have h2 := h 2
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] at h0 h1 h2
    have eu := congrArg (fun n : ℕ => (n : ZMod 2)) (count_mul_scount_xyy hxy u)
    have ew := congrArg (fun n : ℕ => (n : ZMod 2)) (count_mul_scount_xyy hxy w)
    push_cast at eu ew
    linear_combination ew - eu + (scount [x, y, y] u : ZMod 2) * h0 +
      (w.count x : ZMod 2) * h1 - h2 - h1 +
      ((scount [x, x, y, y] w : ZMod 2) - scount [x, x, y, y] u) * two_eq_zero_zmod_two

/-- **Every two-letter word of length four except `xxyy` and `yyxx`, modulo 2.** -/
theorem height_one_two_letters_length_four_mod_two {x y : α} (hxy : x ≠ y) (w : List α)
    (hw : w.length = 4) (hxy' : ∀ z ∈ w, z = x ∨ z = y)
    (hne : w ≠ [x, x, y, y] ∧ w ≠ [y, y, x, x]) {k : ℕ} (hk : k < 2) :
    HasHeightAtMost {u : List α | scount w u % 2 = k} 1 := by
  suffices h : GoodMod 2 (scount w) from h k hk
  match w, hw with
  | [a, b, c, d], _ =>
    rcases hxy' a (by simp) with rfl | rfl <;> rcases hxy' b (by simp) with rfl | rfl <;>
      rcases hxy' c (by simp) with rfl | rfl <;> rcases hxy' d (by simp) with rfl | rfl
    · exact (goodCount_scount_replicate _ 4).goodMod 2
    · exact (goodCount_scount_pst (i := 3) (j := 0) hxy).goodMod 2
    · exact (goodCount_scount_pst (i := 2) (j := 1) hxy).goodMod 2
    · exact absurd rfl hne.1
    · exact (goodCount_scount_pst (i := 1) (j := 2) hxy).goodMod 2
    · exact goodMod_xyxy_two hxy
    · exact goodMod_xyyx_two hxy
    · exact (goodCount_scount_pst (i := 0) (j := 3) (Ne.symm hxy)).goodMod 2
    · exact (goodCount_scount_pst (i := 0) (j := 3) hxy).goodMod 2
    · exact goodMod_xyyx_two (Ne.symm hxy)
    · exact goodMod_xyxy_two (Ne.symm hxy)
    · exact (goodCount_scount_pst (i := 1) (j := 2) (Ne.symm hxy)).goodMod 2
    · exact absurd rfl hne.2
    · exact (goodCount_scount_pst (i := 2) (j := 1) (Ne.symm hxy)).goodMod 2
    · exact (goodCount_scount_pst (i := 3) (j := 0) (Ne.symm hxy)).goodMod 2
    · exact (goodCount_scount_replicate _ 4).goodMod 2

/-- **`xxyy` and `yyxx` stand or fall together**, modulo every `n`. -/
lemma goodMod_xxyy_iff (n : ℕ) {x y : α} (hxy : x ≠ y) :
    GoodMod n (scount [x, x, y, y]) ↔ GoodMod n (scount [y, y, x, x]) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact ⟨fun _ r hr => absurd hr (Nat.not_lt_zero r), fun _ r hr => absurd hr (Nat.not_lt_zero r)⟩
  have key : ∀ (g h : List α → ℕ), (∀ u, g u + h u + scount [x, y, y] u + scount [y, x, x] u +
      (u.count x).choose 2 * (u.count y).choose 2 =
        u.count x * scount [x, y, y] u + u.count y * scount [y, x, x] u) →
      GoodMod n h → GoodMod n g := by
    intro g h hid hh
    refine goodMod_of_det hn ![h, scount [x, y, y], scount [y, x, x],
      fun u => (u.count x).choose 2 * (u.count y).choose 2,
      fun u => u.count x * scount [x, y, y] u + u.count y * scount [y, x, x] u] ?_ ?_
    · intro i
      fin_cases i
      · exact hh
      · exact (goodCount_scount_le_three _ (by simp)).goodMod n
      · exact (goodCount_scount_le_three _ (by simp)).goodMod n
      · exact (((goodCount_count x).choose 2).mul ((goodCount_count y).choose 2)).goodMod n
      · exact (((goodCount_count x).mul (goodCount_scount_le_three _ (by simp))).add
          ((goodCount_count y).mul (goodCount_scount_le_three _ (by simp)))).goodMod n
    · intro u w hw
      have h0 := hw 0; have h1 := hw 1; have h2 := hw 2; have h3 := hw 3; have h4 := hw 4
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons, Matrix.tail_cons] at h0 h1 h2 h3 h4
      have eu := congrArg (fun t : ℕ => (t : ZMod n)) (hid u)
      have ew := congrArg (fun t : ℕ => (t : ZMod n)) (hid w)
      push_cast at eu ew h3 h4
      linear_combination eu - ew - h0 - h1 - h2 - h3 + h4
  constructor
  · intro h
    exact key _ _ (fun u => by have := scount_xxyy_add_yyxx hxy u; omega) h
  · intro h
    exact key _ _ (scount_xxyy_add_yyxx hxy) h

end ModTwo

/-! ### The Frattini corollary -/

section Frattini

/-- The subgroup generated by all commutators and all `p`-th powers. -/
def commPowSubgroup (G : Type) [Group G] (p : ℕ) : Subgroup G :=
  Subgroup.closure ({g | ∃ x y : G, g = x * y * x⁻¹ * y⁻¹} ∪ {g | ∃ x : G, g = x ^ p})

lemma commPowSubgroup_normal (G : Type) [Group G] (p : ℕ) : (commPowSubgroup G p).Normal := by
  have hS : Group.conjugatesOfSet ({g | ∃ x y : G, g = x * y * x⁻¹ * y⁻¹} ∪
      {g | ∃ x : G, g = x ^ p}) ⊆ ({g | ∃ x y : G, g = x * y * x⁻¹ * y⁻¹} ∪
      {g | ∃ x : G, g = x ^ p}) := by
    intro g hg
    obtain ⟨a, ha, hga⟩ := Group.mem_conjugatesOfSet_iff.mp hg
    obtain ⟨c, rfl⟩ := isConj_iff.mp hga
    rcases ha with ⟨x, y, rfl⟩ | ⟨x, rfl⟩
    · left
      exact ⟨c * x * c⁻¹, c * y * c⁻¹, by group⟩
    · right
      exact ⟨c * x * c⁻¹, by rw [conj_pow]⟩
  have heq : commPowSubgroup G p = Subgroup.normalClosure
      ({g | ∃ x y : G, g = x * y * x⁻¹ * y⁻¹} ∪ {g | ∃ x : G, g = x ^ p}) :=
    le_antisymm (Subgroup.closure_le_normalClosure) (Subgroup.closure_mono hS)
  rw [heq]
  infer_instance

/-- **Frattini corollary.** Let `G` be a finite group, `p` a prime, and `N` the subgroup generated
by all commutators and all `p`-th powers.  If `N` is abelian, every language recognized by `G` has
generalized star height at most one.  (For a finite `p`-group, `N` is the Frattini subgroup; that
equality is not proved here and not used.) -/
theorem height_one_of_frattini_abelian {Alphabet : Type u} [Finite Alphabet] {G : Type} [Group G]
    [Fintype G] {p : ℕ} [Fact p.Prime]
    (hab : ∀ x ∈ commPowSubgroup G p, ∀ y ∈ commPowSubgroup G p, x * y = y * x)
    (T : FreeMonoid Alphabet →* G) (F : Set G) :
    HasHeightAtMost {w | T (FreeMonoid.ofList w) ∈ F} 1 := by
  have := commPowSubgroup_normal G p
  exact height_one_of_abelian_normal_exponent_prime (commPowSubgroup G p) hab
    (fun x y => Subgroup.subset_closure (Or.inl ⟨x, y, rfl⟩))
    (fun x => Subgroup.subset_closure (Or.inr ⟨x, rfl⟩)) T F

end Frattini

end GeneralizedStarHeight
