import Start.StarHeightS4TwoLetters
import Start.StarHeightLift

/-!
# `S₄` over the three Coxeter transpositions: generalized star height at most one

`coxT` sends the letters `0, 1, 2` to the Coxeter transpositions `(0 1)`, `(1 2)`, `(2 3)` of
`S₄`.  For every `F ⊆ S₄` the language `{w | coxT w ∈ F}` has generalized star height at most one
(`height_one_S4_coxeter`).

Four observers of the word `w` determine `coxT w` (`coxT_eq_dec`):

* the states reached from `0` by the four-state automata `tA1`, `tA2` and the three-state
  automaton `tP` (the action of `coxT` on the three pairings of `Fin 4`).  In `tA1` and `tA2`
  every letter acts as a `4`-cycle, so these automata do not factor through `coxT`; they are coset
  automata of the order-`192` group `E` generated by the signed permutations sending `i ↦ j`,
  `j ↦ -i` for the letter `(i j)` (an instance of `height_one_of_lift`);
* the length parity `|w| mod 2`, a commutative count.

The decoding table `decL` gives `coxT w` from the four observations.  All `4 · 4 · 3 · 2 = 96`
observation tuples occur, and `dec_step` checks that the decoding is compatible with appending a
letter.  Every state language of the three automata has height at most one, because their return
automata have aperiodic transformation monoids (`good3_base4`, `good3_base3`).  The result follows
from `height_one_of_determined`.
-/

-- The certificates below are checked one at a time, which keeps the peak memory low.
set_option Elab.async false

namespace GeneralizedStarHeight

namespace S4Cox

open Equiv S4Two

/-- The Coxeter generators `(0 1)`, `(1 2)`, `(2 3)` of `S₄`. -/
def coxT : FreeMonoid (Fin 3) →* Equiv.Perm (Fin 4) :=
  FreeMonoid.lift ![Equiv.swap 0 1, Equiv.swap 1 2, Equiv.swap 2 3]

/-! ### Good automata over three letters -/

lemma letters3_mem : ∀ x : Fin 3, x ∈ [(0 : Fin 3), 1, 2] := by decide

lemma st4_closed3 (δ : Fin 4 → Fin 3 → Fin 4) (p : Fin 4) :
    ∀ s ∈ st4 p, ∀ x, DFAReturn.retAut δ p s x ∈ st4 p := by
  intro s hs x
  simp only [st4, List.mem_cons, List.not_mem_nil, or_false] at hs
  rcases hs with rfl | rfl | rfl | rfl | rfl | rfl
  any_goals exact st4_step p _
  all_goals simp [DFAReturn.retAut, st4]

lemma st3_closed3 (δ : Fin 3 → Fin 3 → Fin 3) (p : Fin 3) :
    ∀ s ∈ st3 p, ∀ x, DFAReturn.retAut δ p s x ∈ st3 p := by
  intro s hs x
  simp only [st3, List.mem_cons, List.not_mem_nil, or_false] at hs
  rcases hs with rfl | rfl | rfl | rfl | rfl
  any_goals exact st3_step p _
  all_goals simp [DFAReturn.retAut, st3]

/-- **A good base point of a four-state automaton over three letters.** -/
lemma good3_base4 (δ : Fin 4 → Fin 3 → Fin 4) (p : Fin 4) (N : ℕ)
    (hcert : Aperiodic.certOK (st4 p) [0, 1, 2] (DFAReturn.retAut δ p)
      (Aperiodic.dfaCert (st4 p) [0, 1, 2] (DFAReturn.retAut δ p) 200) N = true) (q : Fin 4) :
    HasHeightAtMost {w : List (Fin 3) | DFAReturn.runQ δ p w = q} 1 := by
  have hsf : ∀ P : Option (Fin 4 × Bool) → Prop,
      HasHeightAtMost {w : List (Fin 3) |
        P (w.foldl (DFAReturn.retAut δ p) (some (p, false)))} 0 :=
    fun P => Aperiodic.starFree_of_dfa_closed (st4 p) (some (p, false)) (st4_start p) [0, 1, 2]
      letters3_mem (DFAReturn.retAut δ p) (st4_closed3 δ p) _ N hcert P
  refine height_one_of_starFree_returns δ p q ?_ ?_
  · rw [DFAReturn.firstReturn_eq_retAut]
    exact hsf fun s => s = some (p, true)
  · rw [DFAReturn.avoidTo_eq_retAut]
    exact hsf fun s => s = some (q, false)

/-- **A good base point of a three-state automaton over three letters.** -/
lemma good3_base3 (δ : Fin 3 → Fin 3 → Fin 3) (p : Fin 3) (N : ℕ)
    (hcert : Aperiodic.certOK (st3 p) [0, 1, 2] (DFAReturn.retAut δ p)
      (Aperiodic.dfaCert (st3 p) [0, 1, 2] (DFAReturn.retAut δ p) 200) N = true) (q : Fin 3) :
    HasHeightAtMost {w : List (Fin 3) | DFAReturn.runQ δ p w = q} 1 := by
  have hsf : ∀ P : Option (Fin 3 × Bool) → Prop,
      HasHeightAtMost {w : List (Fin 3) |
        P (w.foldl (DFAReturn.retAut δ p) (some (p, false)))} 0 :=
    fun P => Aperiodic.starFree_of_dfa_closed (st3 p) (some (p, false)) (st3_start p) [0, 1, 2]
      letters3_mem (DFAReturn.retAut δ p) (st3_closed3 δ p) _ N hcert P
  refine height_one_of_starFree_returns δ p q ?_ ?_
  · rw [DFAReturn.firstReturn_eq_retAut]
    exact hsf fun s => s = some (p, true)
  · rw [DFAReturn.avoidTo_eq_retAut]
    exact hsf fun s => s = some (q, false)

/-! ### The certificate -/

/-- The first auxiliary automaton: `0 ↦ (1,2,3,0)`, `1 ↦ (1,3,0,2)`, `2 ↦ (1,2,3,0)`. -/
def tA1 (q : Fin 4) (x : Fin 3) : Fin 4 :=
  ⟨lk [[1, 1, 1], [2, 3, 2], [3, 0, 3], [0, 2, 0]] q x % 4, Nat.mod_lt _ (by decide)⟩

/-- The second auxiliary automaton: `0 ↦ (1,3,0,2)`, `1 ↦ (1,2,3,0)`, `2 ↦ (2,0,3,1)`. -/
def tA2 (q : Fin 4) (x : Fin 3) : Fin 4 :=
  ⟨lk [[1, 1, 2], [3, 2, 0], [0, 3, 3], [2, 0, 1]] q x % 4, Nat.mod_lt _ (by decide)⟩

/-- The pairing automaton: `0 ↦ (1,0,2)`, `1 ↦ (2,1,0)`, `2 ↦ (1,0,2)`. -/
def tP (q : Fin 3) (x : Fin 3) : Fin 3 :=
  ⟨lk [[1, 2, 1], [0, 1, 0], [2, 0, 2]] q x % 3, Nat.mod_lt _ (by decide)⟩

lemma certA1 : Aperiodic.certOK (st4 0) [0, 1, 2] (DFAReturn.retAut tA1 0)
    (Aperiodic.dfaCert (st4 0) [0, 1, 2] (DFAReturn.retAut tA1 0) 200) 5 = true := by
  decide +kernel

lemma certA2 : Aperiodic.certOK (st4 0) [0, 1, 2] (DFAReturn.retAut tA2 0)
    (Aperiodic.dfaCert (st4 0) [0, 1, 2] (DFAReturn.retAut tA2 0) 200) 5 = true := by
  decide +kernel

lemma certP : Aperiodic.certOK (st3 0) [0, 1, 2] (DFAReturn.retAut tP 0)
    (Aperiodic.dfaCert (st3 0) [0, 1, 2] (DFAReturn.retAut tP 0) 200) 3 = true := by
  decide +kernel

/-- The length parity, a commutative count. -/
def parHom : FreeMonoid (Fin 3) →* Multiplicative (ZMod 2) :=
  FreeMonoid.lift fun _ => Multiplicative.ofAdd 1

/-- The parity observer. -/
def par (w : List (Fin 3)) : ZMod 2 := Multiplicative.toAdd (parHom (FreeMonoid.ofList w))

lemma par_height (e : ZMod 2) : HasHeightAtMost {w : List (Fin 3) | par w = e} 1 :=
  height_one_of_comm (fun x y => mul_comm x y) parHom ({Multiplicative.ofAdd e} : Set _)

lemma par_append (w : List (Fin 3)) (x : Fin 3) : par (w ++ [x]) = par w + 1 := by
  simp [par, parHom, FreeMonoid.ofList_append]

/-- The decoding table: row `((a · 4 + b) · 3 + p) · 2 + e` lists the values of `coxT w` at
`0, 1, 2, 3` when the observations are `a, b, p, e`. -/
def decL : List (List ℕ) :=
  [[0, 1, 2, 3], [2, 1, 0, 3], [1, 2, 0, 3], [1, 0, 2, 3], [2, 0, 1, 3], [0, 2, 1, 3],
    [2, 3, 0, 1], [0, 3, 2, 1], [0, 3, 1, 2], [2, 3, 1, 0], [1, 3, 2, 0], [1, 3, 0, 2],
    [3, 2, 1, 0], [3, 0, 1, 2], [3, 0, 2, 1], [3, 2, 0, 1], [3, 1, 0, 2], [3, 1, 2, 0],
    [1, 0, 3, 2], [1, 2, 3, 0], [2, 1, 3, 0], [0, 1, 3, 2], [0, 2, 3, 1], [2, 0, 3, 1],
    [2, 3, 0, 1], [0, 3, 2, 1], [0, 3, 1, 2], [2, 3, 1, 0], [1, 3, 2, 0], [1, 3, 0, 2],
    [0, 1, 2, 3], [2, 1, 0, 3], [1, 2, 0, 3], [1, 0, 2, 3], [2, 0, 1, 3], [0, 2, 1, 3],
    [1, 0, 3, 2], [1, 2, 3, 0], [2, 1, 3, 0], [0, 1, 3, 2], [0, 2, 3, 1], [2, 0, 3, 1],
    [3, 2, 1, 0], [3, 0, 1, 2], [3, 0, 2, 1], [3, 2, 0, 1], [3, 1, 0, 2], [3, 1, 2, 0],
    [1, 0, 3, 2], [1, 2, 3, 0], [2, 1, 3, 0], [0, 1, 3, 2], [0, 2, 3, 1], [2, 0, 3, 1],
    [3, 2, 1, 0], [3, 0, 1, 2], [3, 0, 2, 1], [3, 2, 0, 1], [3, 1, 0, 2], [3, 1, 2, 0],
    [2, 3, 0, 1], [0, 3, 2, 1], [0, 3, 1, 2], [2, 3, 1, 0], [1, 3, 2, 0], [1, 3, 0, 2],
    [0, 1, 2, 3], [2, 1, 0, 3], [1, 2, 0, 3], [1, 0, 2, 3], [2, 0, 1, 3], [0, 2, 1, 3],
    [3, 2, 1, 0], [3, 0, 1, 2], [3, 0, 2, 1], [3, 2, 0, 1], [3, 1, 0, 2], [3, 1, 2, 0],
    [1, 0, 3, 2], [1, 2, 3, 0], [2, 1, 3, 0], [0, 1, 3, 2], [0, 2, 3, 1], [2, 0, 3, 1],
    [0, 1, 2, 3], [2, 1, 0, 3], [1, 2, 0, 3], [1, 0, 2, 3], [2, 0, 1, 3], [0, 2, 1, 3],
    [2, 3, 0, 1], [0, 3, 2, 1], [0, 3, 1, 2], [2, 3, 1, 0], [1, 3, 2, 0], [1, 3, 0, 2]]

/-- The decoding of an observation tuple. -/
def dec (a b : Fin 4) (p : Fin 3) (e : ZMod 2) (i : Fin 4) : Fin 4 :=
  ⟨lk decL (((a.val * 4 + b.val) * 3 + p.val) * 2 + e.val) i % 4, Nat.mod_lt _ (by decide)⟩

/-- The letters as tables. -/
def swt (x : Fin 3) (i : Fin 4) : Fin 4 :=
  ⟨lk [[1, 0, 2, 3], [0, 2, 1, 3], [0, 1, 3, 2]] x i % 4, Nat.mod_lt _ (by decide)⟩

lemma dec_start : ∀ i : Fin 4, dec 0 0 0 0 i = i := by decide

lemma dec_step : ∀ (a b : Fin 4) (p : Fin 3) (e : ZMod 2) (x : Fin 3) (i : Fin 4),
    dec (tA1 a x) (tA2 b x) (tP p x) (e + 1) i = dec a b p e (swt x i) := by
  decide +kernel

lemma coxT_of_tab : ∀ (x : Fin 3) (i : Fin 4),
    (![Equiv.swap 0 1, Equiv.swap 1 2, Equiv.swap 2 3] x : Equiv.Perm (Fin 4)) i = swt x i := by
  decide

lemma coxT_of (x : Fin 3) (i : Fin 4) : coxT (FreeMonoid.of x) i = swt x i := by
  rw [coxT, FreeMonoid.lift_eval_of]
  exact coxT_of_tab x i

/-- **The four observations determine `coxT w`.** -/
theorem coxT_eq_dec (w : List (Fin 3)) (i : Fin 4) :
    coxT (FreeMonoid.ofList w) i =
      dec (DFAReturn.runQ tA1 0 w) (DFAReturn.runQ tA2 0 w) (DFAReturn.runQ tP 0 w) (par w) i := by
  induction w using List.reverseRecOn generalizing i with
  | nil =>
      rw [show FreeMonoid.ofList ([] : List (Fin 3)) = 1 from rfl, map_one]
      exact (dec_start i).symm
  | append_singleton w x ih =>
      rw [FreeMonoid.ofList_append, map_mul, FreeMonoid.ofList_singleton, Equiv.Perm.mul_apply,
        coxT_of, ih, DFAReturn.runQ_append_single, DFAReturn.runQ_append_single,
        DFAReturn.runQ_append_single, par_append, dec_step]

/-- The joint observation of a word. -/
def obsAll (w : List (Fin 3)) : Fin 4 × Fin 4 × Fin 3 × ZMod 2 :=
  (DFAReturn.runQ tA1 0 w, DFAReturn.runQ tA2 0 w, DFAReturn.runQ tP 0 w, par w)

lemma obsAll_height (o : Fin 4 × Fin 4 × Fin 3 × ZMod 2) :
    HasHeightAtMost {w | obsAll w = o} 1 := by
  obtain ⟨a, b, p, e⟩ := o
  have heq : ({w | obsAll w = (a, b, p, e)} : Language (Fin 3)) =
      (({w | DFAReturn.runQ tA1 0 w = a} ⊓ {w | DFAReturn.runQ tA2 0 w = b}) ⊓
        {w | DFAReturn.runQ tP 0 w = p}) ⊓ {w | par w = e} := by
    ext w
    simp only [obsAll, Prod.mk.injEq]
    exact ⟨fun ⟨h1, h2, h3, h4⟩ => ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩,
      fun ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ => ⟨h1, h2, h3, h4⟩⟩
  rw [heq]
  exact (((good3_base4 tA1 0 5 certA1 a).inter (good3_base4 tA2 0 5 certA2 b)).inter
    (good3_base3 tP 0 3 certP p)).inter (par_height e)

/-! ### The theorem -/

/-- **Every language recognized by `S₄` over the three Coxeter transpositions has generalized
star height at most one.** -/
theorem height_one_S4_coxeter (F : Set (Equiv.Perm (Fin 4))) :
    HasHeightAtMost {w : List (Fin 3) | coxT (FreeMonoid.ofList w) ∈ F} 1 := by
  refine height_one_of_determined (fun w => coxT (FreeMonoid.ofList w)) (ι := Unit)
    (X := fun _ => Fin 4 × Fin 4 × Fin 3 × ZMod 2) (fun _ => obsAll) ?_ (fun _ => obsAll_height) F
  intro u v huv
  have h := huv ()
  simp only [obsAll, Prod.mk.injEq] at h
  obtain ⟨h1, h2, h3, h4⟩ := h
  exact Equiv.ext fun i => by rw [coxT_eq_dec, coxT_eq_dec, h1, h2, h3, h4]

end S4Cox

end GeneralizedStarHeight
