/-
`Lambda.subst_code'` computes the code of `t[x := s]` given the codes of `s` and `t`, and the variable index `x`. It uses strong recursion on the code of `t`.
-/
def Lambda.subst_code' (s_code : ℕ) (t_code : ℕ) : ℕ → ℕ :=
  Nat.strongRecOn t_code (fun t_code ih x =>
    match h : t_code.unpair with
    | (0, y) => if x = y then s_code else t_code
    | (1, m) =>
      match hm : m.unpair with
      | (t1_code, t2_code) =>
        have h1 : t1_code < t_code := Lambda.decode_lt_1 h hm
        have h2 : t2_code < t_code := Lambda.decode_lt_2 h hm
        Lambda.app_code (ih t1_code h1 x) (ih t2_code h2 x)
    | (2, t'_code) =>
      have h' : t'_code < t_code := Lambda.decode_lt_3 h
      Lambda.lam_code (ih t'_code h' (x + 1))
    | _ => 0
  )

/-
`Lambda.subst_code'` correctly computes the code of the substituted term, matching `Lambda.subst`.
-/
theorem Lambda.subst_code'_correct (s : Lambda) (x : ℕ) (t : Lambda) :
  Lambda.subst_code' (Lambda.encode s) (Lambda.encode t) x = Lambda.encode (Lambda.subst s x t) := by
    revert t;
    -- By definition of `subst_code'`, we can split into cases based on the structure of `t`.
    have h_cases : ∀ (t : Lambda) (x : ℕ), Lambda.subst_code' s.encode t.encode x = (Lambda.subst s x t).encode := by
      intro t x
      exact (by
      induction' t with t ih generalizing x;
      · unfold subst_code';
        convert rfl;
        rw [ Nat.strongRecOn_eq ];
        unfold Lambda.subst; aesop;
        all_goals unfold Lambda.encode at *; aesop;
      · -- Apply the definition of `subst_code'` to the application case.
        have h_app : Lambda.subst_code' s.encode (Lambda.encode (Lambda.app ih ‹_›)) x = Lambda.app_code (Lambda.subst_code' s.encode ih.encode x) (Lambda.subst_code' s.encode ‹Lambda›.encode x) := by
          unfold subst_code';
          simp ( config := { decide := Bool.true } ) [ Lambda.encode ];
          rw [ Nat.strongRecOn_eq ];
          simp ( config := { decide := Bool.true } ) [ Nat.unpair_pair ];
          rw [ Nat.unpair_pair ];
          simp +zetaDelta at *;
        aesop;
      · -- By definition of `Lambda.encode`, we know that `Lambda.encode (Lambda.lam t) = Nat.pair 2 (Lambda.encode t)`.
        have h_encode_lam : Lambda.encode (Lambda.lam ‹_›) = Nat.pair 2 (Lambda.encode ‹_›) := by
          rfl;
        unfold Lambda.subst_code' at *;
        rw [ h_encode_lam ];
        rw [ Nat.strongRecOn_eq ];
        unfold Lambda.subst at *; aesop;);
    exact fun t => h_cases t x

/-
`Lambda.step_code'` is a corrected version of `Lambda.step_code` that uses `Lambda.subst_code'` for beta reduction. It computes the code of the next step of reduction given a list of previous results.
-/
def Lambda.step_code_case1' (L : List (Option ℕ)) : Option (Option ℕ) :=
  let c := L.length
  let m := c.unpair.2
  let (c1, c2) := m.unpair
  if c1 < c ∧ c2 < c then
    match c1.unpair with
    | (2, c1_body) => some (some (Lambda.subst_code' c2 c1_body 0))
    | _ =>
      (L[c1]?).bind (fun res1 =>
        match res1 with
        | some c1' => some (some (Lambda.app_code c1' c2))
        | none =>
          (L[c2]?).bind (fun res2 =>
            match res2 with
            | some c2' => some (some (Lambda.app_code c1 c2'))
            | none => some none
          )
      )
  else none

def Lambda.step_code' (L : List (Option ℕ)) : Option (Option ℕ) :=
  let c := L.length
  match c.unpair with
  | (0, m) => some none
  | (1, m) => Lambda.step_code_case1' L
  | (2, m) => Lambda.step_code_case2 L
  | _ => some none

