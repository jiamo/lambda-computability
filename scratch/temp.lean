    unfold subst_ecf_step;
    unfold subst_ecf_step_case0 subst_ecf_step_case1 subst_ecf_step_case2; aesop;
    · unfold subst_ecf; aesop;
      rw [ Nat.strongRecOn_eq ] ; aesop;
      cases n : Nat.unpair n ; aesop;
    · unfold subst_ecf; aesop;
      rw [ List.getElem?_range, List.getElem?_range ];
      · rw [ Nat.strongRecOn_eq ] ; aesop;
