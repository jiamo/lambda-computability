/-
`seq_apply G` applied to a numeral `n` reduces to `G n`.
-/
theorem Lambda.seq_apply_church (G : Lambda) (n : ℕ) (hG : Lambda.IsClosed G) :
  Lambda.reduces (Lambda.app (Lambda.seq_apply G) (Lambda.church n)) (Lambda.app G (Lambda.church n)) := by
    have := @Lambda.seq_apply_reduces G ( Lambda.church n );
    have := @Lambda.church_const_fun n ( G.app ( church n ) ) ?_;
    · exact Lambda.reduces_trans (‹_ → _› hG) ‹_›;
    · -- Since G is closed and church n is closed, their application is also closed.
      have h_closed : Lambda.IsClosed (Lambda.app G (Lambda.church n)) := by
        have hG_closed : Lambda.IsClosed G := hG
        have hchurch_closed : Lambda.IsClosed (Lambda.church n) := by
          exact Lambda.church_closed n
        exact Lambda.IsClosed_app hG_closed hchurch_closed;
      exact h_closed

