/-
Helper lemma for termination of Lambda.decode: if n unpairs to (1, m) and m unpairs to (c₁, c₂), then c₁ < n.
-/
theorem Lambda.decode_lt_1 {n m c₁ c₂ : ℕ} (h : n.unpair = (1, m)) (hm : m.unpair = (c₁, c₂)) : c₁ < n := by
  unfold Nat.unpair at *; aesop;
  · nlinarith [ Nat.sub_add_cancel ( Nat.sqrt_le n ), Nat.sub_add_cancel ( Nat.sqrt_le ( Nat.sqrt n ) ), Nat.sqrt_le n, Nat.sqrt_le ( Nat.sqrt n ) ];
  · exact lt_of_le_of_lt ( Nat.sqrt_le_self _ ) ( by nlinarith [ Nat.sub_add_cancel ( Nat.sqrt_le n ) ] );
  · grind;
  · rcases n with ( _ | _ | _ | n ) <;> simp_all +arith +decide [ Nat.sqrt_lt ];
    nlinarith

/-
Helper lemma for termination of Lambda.decode: if n unpairs to (1, m) and m unpairs to (c₁, c₂), then c₂ < n.
-/
theorem Lambda.decode_lt_2 {n m c₁ c₂ : ℕ} (h : n.unpair = (1, m)) (hm : m.unpair = (c₁, c₂)) : c₂ < n := by
  unfold Nat.unpair at *; aesop;
  · nlinarith [ Nat.sub_add_cancel ( Nat.sqrt_le' n ), Nat.sub_add_cancel ( Nat.sqrt_le' ( Nat.sqrt n ) ) ];
  · rw [ tsub_tsub, tsub_lt_iff_left ];
    · nlinarith only [ Nat.sqrt_le n, Nat.sqrt_le ( Nat.sqrt n ), h_1 ];
    · nlinarith [ Nat.sub_add_cancel ( show n.sqrt.sqrt * n.sqrt.sqrt ≤ n.sqrt from by nlinarith [ Nat.sqrt_le n.sqrt ] ) ];
  · exact lt_of_le_of_lt ( Nat.sqrt_le_self _ ) ( by omega );
  · omega

/-
Helper lemma for termination of Lambda.decode: if n unpairs to (2, m), then m < n.
-/
theorem Lambda.decode_lt_3 {n m : ℕ} (h : n.unpair = (2, m)) : m < n := by
  unfold Nat.unpair at h;
  aesop;
  · nlinarith [ Nat.sub_add_cancel ( Nat.sqrt_le' n ) ];
  · omega

/-
Decoding of natural numbers to Lambda terms using strong recursion and helper lemmas for termination.
-/
/-- Decoding of Nat to Lambda terms -/
def Lambda.decode (n : ℕ) : Option Lambda :=
  Nat.strongRecOn n (fun n ih =>
    match h : n.unpair with
    | (0, m) => some (Lambda.var m)
    | (1, m) =>
      match hm : m.unpair with
      | (c₁, c₂) =>
        have h₁ : c₁ < n := Lambda.decode_lt_1 h hm
        have h₂ : c₂ < n := Lambda.decode_lt_2 h hm
        match ih c₁ h₁, ih c₂ h₂ with
        | some t₁, some t₂ => some (Lambda.app t₁ t₂)
        | _, _ => none
    | (2, m) =>
      have h' : m < n := Lambda.decode_lt_3 h
      match ih m h' with
      | some t => some (Lambda.lam t)
      | _ => none
    | _ => none)

/-
Encodable instance for Lambda.
-/
instance : Encodable Lambda where
  encode := Lambda.encode
  decode := Lambda.decode
  encodek := by
    -- We can prove this by induction on the structure of the Lambda term.
    intro a
    induction' a with n ih;
    · -- By definition of encode, we have encode (var n) = Nat.pair 0 n.
      simp [Lambda.encode];
      unfold Lambda.decode;
      rw [ Nat.strongRecOn_eq ] ; aesop;
    · rename_i a ha;
      unfold Lambda.encode;
      unfold Lambda.decode; aesop;
      rw [ Nat.strongRecOn_eq ];
      simp +decide [ Nat.pair_unpair ];
      rw [ Nat.unpair_pair ];
      simp +decide [ Nat.unpair_pair ];
      rw [ show Nat.strongRecOn ih.encode _ = Option.some ih from a, show Nat.strongRecOn a_1.encode _ = Option.some a_1 from ha ];
    · -- By definition of decode, if n.unpair.1 = 2 and n.unpair.2.unpair = (c₁, c₂) with c₁, c₂ < n, then decode n is some (Lambda.lam (decode c₁)).
      simp [Lambda.decode, Lambda.encode] at *;
      rw [ Nat.strongRecOn_eq ];
      simp +decide [ Nat.unpair_pair ];
      rw [ Nat.unpair_pair ] ; simp +decide [ * ]

