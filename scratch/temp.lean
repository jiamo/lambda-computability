  constructor;
  constructor;
  constructor;
  constructor;
  erw [ hx ] ; tauto;

/-
`ifThenElse true a b` reduces to `a` for closed `a`.
-/
theorem Lambda.ifThenElse_true (a b : Lambda) (ha : Lambda.IsClosed a) : Lambda.reduces (Lambda.app (Lambda.app (Lambda.app Lambda.ifThenElse Lambda.true) a) b) a := by
  -- Since `true` is a closed term, we can use the fact that `true x y` reduces to `x`.
  have h_true : Lambda.reduces (Lambda.app (Lambda.app Lambda.true a) b) a := by
    have := @Lambda.true_works a b ha;
    exact this;
  -- Since `ifThenElse` is defined as `fun z. z`, applying it to `true` should just return `true`.
  have h_ifThenElse_true : Lambda.reduces (Lambda.app Lambda.ifThenElse Lambda.true) Lambda.true := by
    constructor;
    all_goals constructor;
    constructor;
    constructor;
    constructor;
    constructor;
    constructor;
    constructor;
    constructor;
    constructor;
    constructor;
  -- Applying the reduction rule for ifThenElse, we get `ifThenElse true a b` reduces to `true a b`.
  have h_ifThenElse_step1 : Lambda.reduces (Lambda.app (Lambda.app Lambda.ifThenElse Lambda.true) a) (Lambda.app Lambda.true a) := by
    have h_ifThenElse_step1 : ∀ t1 t2 t3, Lambda.reduces t1 t2 → Lambda.reduces (Lambda.app t1 t3) (Lambda.app t2 t3) := by
      intros t1 t2 t3 h; exact (by
      induction h <;> constructor <;> tauto);
    exact h_ifThenElse_step1 _ _ _ h_ifThenElse_true;
  -- Applying the reduction rule for ifThenElse again, we get `ifThenElse true a b` reduces to `true a b`.
  have h_ifThenElse_step2 : Lambda.reduces (Lambda.app (Lambda.app (Lambda.app Lambda.ifThenElse Lambda.true) a) b) (Lambda.app (Lambda.app Lambda.true a) b) := by
    have h_ifThenElse_step2 : ∀ t1 t2, Lambda.reduces t1 t2 → Lambda.reduces (Lambda.app t1 b) (Lambda.app t2 b) := by
      intros t1 t2 h; exact Lambda.reduces_app_left h
    exact h_ifThenElse_step2 _ _ h_ifThenElse_step1;
  exact Lambda.reduces_trans h_ifThenElse_step2 h_true

/-
`ifThenElse false a b` reduces to `b`.
