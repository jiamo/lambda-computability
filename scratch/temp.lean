          -- By definition of `step_code'`, we know that it correctly computes the next step of reduction for the application of a lambda abstraction.
          have h_step_code_case1 : ∀ (L : List (Option ℕ)), (List.length L) = Nat.pair 1 (Nat.pair (Nat.pair 2 (Lambda.encode t1_body)) (Lambda.encode t2)) → (Lambda.step_code' L) = some (some (Lambda.subst_code' (Lambda.encode t2) (Lambda.encode t1_body) 0)) := by
            unfold step_code';
            unfold step_code_case1'; aesop;
            · unfold Nat.pair; simp +arith +decide;
