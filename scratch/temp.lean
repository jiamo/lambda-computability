/-
A lemma stating that a beta reduction step implies reduction in the reflexive transitive closure.
-/
theorem Lambda.beta_reduces {t1 t2 : Lambda} :
  Lambda.reduces (Lambda.app (Lambda.lam t1) t2) (Lambda.subst t2 0 t1) :=
  Lambda.reduces.step _ _ _ (Lambda.step.beta t1 t2) (Lambda.reduces.refl _)

/-
The identity combinator `I` reduces its argument to itself.
-/
theorem Lambda.I_works (x : Lambda) : Lambda.reduces (Lambda.app Lambda.I x) x := by
  -- By definition of `Lambda.reduces`, we know that if `t₁` reduces to `t₂`, then `t₁` reduces to `t₂`.
  apply Lambda.beta_reduces

/-
`Lambda.succ (church n)` reduces to `\f x. f (church n f x)`.
-/
theorem Lambda.succ_reduces_step1 (n : ℕ) :
  Lambda.reduces (Lambda.app Lambda.succ (Lambda.church n))
    (Lambda.lam (Lambda.lam (Lambda.app (Lambda.var 1) (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.var 0))))) := by
      convert Lambda.beta_reduces using 1

/-
Substituting `s` for `x` in `var x` yields `s`.
-/
theorem Lambda.subst_var_eq (s : Lambda) (x : ℕ) : Lambda.subst s x (Lambda.var x) = s := by
  exact if_pos rfl

/-
Substituting `s` for `x` in `var y` yields `var y` if `x ≠ y`.
-/
theorem Lambda.subst_var_ne (s : Lambda) (x y : ℕ) (h : x ≠ y) : Lambda.subst s x (Lambda.var y) = Lambda.var y := by
  exact if_neg h

/-
If `t1` reduces to `t1'`, then `app t1 t2` reduces to `app t1' t2`.
-/
theorem Lambda.reduces_app_left {t1 t1' t2 : Lambda} (h : Lambda.reduces t1 t1') :
  Lambda.reduces (Lambda.app t1 t2) (Lambda.app t1' t2) := by
    induction' h with t1'' t1''' h';
    · constructor;
    · constructor;
      exact Lambda.step.app_left _ _ _ ‹_›;
      assumption

/-
If `t2` reduces to `t2'`, then `app t1 t2` reduces to `app t1 t2'`.
-/
theorem Lambda.reduces_app_right {t1 t2 t2' : Lambda} (h : Lambda.reduces t2 t2') :
  Lambda.reduces (Lambda.app t1 t2) (Lambda.app t1 t2') := by
    -- By definition of reduction, if $t2 \to t2'$, then $t1.app t2 \to t1.app t2'$.
    induction' h with t2 t2' h ih;
    · constructor;
    · apply_rules [ Lambda.reduces.step, Lambda.reduces.refl ];
      exact Lambda.step.app_right _ _ _ ‹_›

/-
If `t` reduces to `t'`, then `lam t` reduces to `lam t'`.
-/
theorem Lambda.reduces_lam {t t' : Lambda} (h : Lambda.reduces t t') :
  Lambda.reduces (Lambda.lam t) (Lambda.lam t') := by
    -- By definition of reduces, if t reduces to t', then Lam t must reduce to Lam t'.
    induction' h with t'' ht'' ht''_red;
    · constructor;
    · constructor;
      exact Lambda.step.lam _ _ ‹_›;
      assumption

/-
`church n` applied to `var 1` and `var 0` reduces to `iterate (var 1) (var 0) n`.
-/
theorem Lambda.succ_reduces_step2 (n : ℕ) :
  Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.var 0))
                 (Lambda.iterate (Lambda.var 1) (Lambda.var 0) n) := by
                   convert Lambda.church_reduces_iterate n ( Lambda.var 1 ) ( Lambda.var 0 ) using 1

/-
The Lambda term `Lambda.succ` correctly increments a Church numeral.
-/
theorem Lambda.succ_works (n : ℕ) : Lambda.reduces (Lambda.app Lambda.succ (Lambda.church n)) (Lambda.church (n + 1)) := by
  -- First, use `Lambda.succ_reduces_step1` to show that the term reduces to the intermediate form.
  have h1 : Lambda.reduces (Lambda.app Lambda.succ (Lambda.church n)) (Lambda.lam (Lambda.lam (Lambda.app (Lambda.var 1) (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.var 0))))) := by
    exact Lambda.succ_reduces_step1 n;
  -- Apply `Lambda.succ_reduces_step2` to show that the intermediate form reduces to the final form.
  have h2 : Lambda.reduces (Lambda.lam (Lambda.lam (Lambda.app (Lambda.var 1) (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.var 0))))) (Lambda.lam (Lambda.lam (Lambda.app (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) n)))) := by
    apply_rules [ Lambda.reduces_lam, Lambda.reduces_app_right ];
    exact Lambda.succ_reduces_step2 n;
  -- By transitivity of reduction, we can combine h1 and h2 to conclude the proof.
  have h_trans : Lambda.reduces (Lambda.app Lambda.succ (Lambda.church n)) (Lambda.lam (Lambda.lam (Lambda.app (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) n)))) := by
    have h_trans : ∀ (t1 t2 t3 : Lambda), Lambda.reduces t1 t2 → Lambda.reduces t2 t3 → Lambda.reduces t1 t3 := by
      intros t1 t2 t3 h1 h2;
      induction h1 <;> tauto;
    exact h_trans _ _ _ h1 h2;
  convert h_trans using 1;
  -- By definition of `Lambda.church`, we know that `Lambda.church (n + 1)` is the abstraction of the iteration of `var 1` and `var 0` `n + 1` times.
  simp [Lambda.church, Lambda.iterate];
  simp ( config := { decide := Bool.true } ) [ List.range_succ ]

/-
The Lambda term `Lambda.succ` correctly increments a Church numeral.
-/
theorem Lambda.succ_correct (n : ℕ) : Lambda.reduces (Lambda.app Lambda.succ (Lambda.church n)) (Lambda.church (n + 1)) := by
  exact Lambda.succ_works n

/-
If `f` is Lambda-computable, and `Lambda.eval` is correct, then `f` is computed by `Lambda.compute_fun`.
-/
theorem LambdaComputable_imp_compute_fun_aux
  (h_eval_correct : ∀ t n, Lambda.reduces t (Lambda.church n) ↔ Lambda.eval (Lambda.encode t) = Part.some (Lambda.church_code n))
  {f : ℕ →. ℕ} (h : LambdaComputable f) :
  ∃ c, ∀ n, Lambda.compute_fun c n = f n := by
    obtain ⟨ F, hF ⟩ := h;
    use Lambda.encode F; intro n; specialize hF n; aesop;
    unfold Lambda.compute_fun;
    rw [ show ( Lambda.app_code F.encode ( Lambda.church_code n ) ) = ( Lambda.app F ( Lambda.church n ) |> Lambda.encode ) from ?_ ];
    · cases h : Lambda.eval ( F.app ( Lambda.church n ) |> Lambda.encode ) <;> aesop;
      by_cases h' : ∃ m, f n = Part.some m <;> aesop;
      · specialize hF w; aesop;
        have := Lambda.unchurch_code_correct w; aesop;
      · ext m; specialize hF m; aesop;
        · contrapose! h';
          have := Lambda.unchurch_code_eq_some_iff ( get w ) m; aesop;
        · cases h : f n <;> aesop
          all_goals sorry;
    · rw [ ← Lambda.encode_church_eq_church_code ];
      rfl


