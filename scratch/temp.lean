/-
`Lambda.subst_ecf` computes an ECF representing the substitution `t[x := s]` as a function of `x`. It is defined by strong recursion on the code of `t`.
-/
def Lambda.subst_ecf (s_code : ℕ) (t_code : ℕ) : ECF :=
  Nat.strongRecOn t_code (fun t_code ih =>
    match h : t_code.unpair with
    | (0, y) => mk_var_ecf s_code y
    | (1, m) =>
      match hm : m.unpair with
      | (t1_code, t2_code) =>
        have h1 : t1_code < t_code := Lambda.decode_lt_1 h hm
        have h2 : t2_code < t_code := Lambda.decode_lt_2 h hm
        mk_app_ecf (ih t1_code h1) (ih t2_code h2)
    | (2, t'_code) =>
      have h' : t'_code < t_code := Lambda.decode_lt_3 h
      mk_lam_ecf (ih t'_code h')
    | _ => ([], 0)
  )

