theorem Lambda.unchurch_code_correct (n : ℕ) : Lambda.unchurch_code (Lambda.church_code n) = some n := by
  unfold Lambda.unchurch_code;
  unfold church_code; rw [ Nat.unpair_pair ] ; norm_num [ Lambda.unbody_code_correct ] ;

