            · unfold Nat.pair; simp +arith +decide;
              split_ifs <;> nlinarith;
          exact h_step_code_case1 _ ( by simp +decide [ Lambda.encode ] );
        rw [h_step', Lambda.subst_code'_correct]
      grind;
    exact h_step

