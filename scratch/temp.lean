/-
Church numerals are injective.
-/
theorem Lambda.church_injective {n m : ℕ} (h : Lambda.church n = Lambda.church m) : n = m := by
  -- By definition of `church`, we know that `church n = \f x. f (church (n-1) f x)` and `church m = \f x. f (church (m-1) f x)`.
  -- Since these two expressions are equal, their bodies must be equal, leading to `church (n-1) = church (m-1)`.
  -- By induction, this implies `n-1 = m-1`, and thus `n = m`.
  have h_body : ∀ {t1 t2 : Lambda}, t1.lam = t2.lam → t1 = t2 := by
    grind;
  apply h_body at h;
  induction' n with n ih generalizing m <;> induction' m with m ih' <;> simp_all +decide [ List.range_succ ];
  grind

/-
Assuming confluence, Church numerals have unique normal forms.
-/
section Confluence

variable (confluence : ∀ {t t1 t2 : Lambda}, Lambda.reduces t t1 → Lambda.reduces t t2 → ∃ t3, Lambda.reduces t1 t3 ∧ Lambda.reduces t2 t3)

theorem Lambda.church_unique_normal_form {n m : ℕ} :
  Lambda.reduces (Lambda.church n) (Lambda.church m) → n = m := by
    -- By Lemma 25, if `church n` reduces to `church m`, then `n = m` because `church n` and `church m` are normal forms.
    intros h_reduction
    apply Lambda.church_injective;
    -- By Lemma 25, if `church n` reduces to `church m`, then `n = m` because `church n` and `church m` are normal forms. Hence, we can conclude that `church n = church m`.
    have h_normal : ∀ t : Lambda, Lambda.is_normal t → ∀ t' : Lambda, Lambda.reduces t t' → t = t' := by
      intro t ht t' ht'
      induction' ht' with t'' ht'';
      · rfl;
      · cases ht _ ‹_›;
    exact h_normal _ ( Lambda.church_normal _ ) _ h_reduction ▸ rfl

end Confluence

/-
A normal form reduces only to itself.
-/
theorem Lambda.reduces_normal_eq {t t' : Lambda} (h : Lambda.is_normal t) (r : Lambda.reduces t t') : t = t' := by
  cases r <;> tauto


