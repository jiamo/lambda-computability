/-
`Lambda.unbody_code_step` is primitive recursive.
-/
def Lambda.unbody_code_step (L : List (Option ℕ)) : Option ℕ :=
  let n := L.length
  if n = Nat.pair 0 0 then some 0
  else
    match n.unpair with
    | (1, m) =>
      match m.unpair with
      | (f, rest) =>
        if f = Nat.pair 0 1 then
          if rest < n then
             Lambda.unbody_code_step_inner L rest
          else none
        else none
    | _ => none

theorem Lambda.unbody_code_step_primrec : Primrec Lambda.unbody_code_step := by
  -- The function `unbody_code_step` is defined using primitive recursive components: `if`, `unpair`, `map`, and `dash`.
  have h_primrec : Primrec (fun c : ℕ => if c = Nat.pair 0 0 then some 0 else none) := by
    -- The function that returns `some 0` if `c = Nat.pair 0 0` and `none` otherwise can be constructed using `Primrec.cond`.
    have h_cond : Primrec (fun c : ℕ => if c = Nat.pair 0 0 then true else false) := by
      convert Primrec.eq.comp (Primrec.id) (Primrec.const (Nat.pair 0 0)) using 1;
      constructor <;> intro h <;> rw [ PrimrecPred ] at * <;> aesop;
      grind;
    convert Primrec.cond h_cond ( Primrec.const ( some 0 ) ) ( Primrec.const ( none : Option ℕ ) ) using 1;
    grind;
  convert Primrec.cond _ _ _;
  rotate_left;
  exact fun L => L.length.unpair.1 = 1 ∧ L.length.unpair.2.unpair.1 = Nat.pair 0 1;
  exact fun L => ( L[L.length.unpair.2.unpair.2]? |> Option.bind <| fun res => res.map Nat.succ );
  exact fun L => if L.length = Nat.pair 0 0 then some 0 else none;
  · -- The function that checks if the first element of the unpair of the length of the list is 1 and the first element of the unpair of the second element of the unpair is 0 is primitive recursive.
    have h_cond : Primrec (fun L : List (Option ℕ) => decide ((Nat.unpair L.length).1 = 1)) ∧ Primrec (fun L : List (Option ℕ) => decide ((Nat.unpair (Nat.unpair L.length).2).1 = Nat.pair 0 1)) := by
      constructor;
      · have h_cond : Primrec (fun L : List (Option ℕ) => (Nat.unpair L.length).1) := by
          have h_cond : Primrec (fun n : ℕ => (Nat.unpair n).1) := by
            exact Primrec.fst.comp ( Primrec.unpair.comp ( Primrec.id ) );
          exact h_cond.comp ( Primrec.list_length );
        have h_cond : Primrec (fun n : ℕ => decide (n = 1)) := by
          convert Primrec.eq.comp ( Primrec.id ) ( Primrec.const 1 ) using 1;
          aesop;
          · convert a using 1;
            constructor <;> intro h <;> rw [ PrimrecPred ] at * <;> aesop;
          · convert a using 1;
            constructor <;> intro h <;> rw [ PrimrecPred ] at * <;> aesop;
            grind;
        exact h_cond.comp ‹_›;
      · -- The function that checks if the first element of the unpair of the second element of the unpair of the length of the list is equal to Nat.pair 0 1 is primitive recursive.
        have h_cond : Primrec (fun L : List (Option ℕ) => (Nat.unpair (Nat.unpair L.length).2).1) := by
          have h_cond : Primrec (fun n : ℕ => (Nat.unpair (Nat.unpair n).2).1) := by
            exact Primrec.fst.comp ( Primrec.unpair.comp ( Primrec.snd.comp ( Primrec.unpair ) ) );
          exact h_cond.comp ( Primrec.list_length );
        convert Primrec.eq.comp h_cond ( Primrec.const ( Nat.pair 0 1 ) ) using 1;
        constructor <;> intro h <;> rw [ PrimrecPred ] at * <;> aesop;
        grind;
    bound;
    exact Primrec.of_eq ( Primrec.cond left right ( Primrec.const false ) ) ( by aesop );
  · -- The function `unbody_code_step_inner` is primitive recursive, as given by `h_primrec`.
    have h_primrec_inner : Primrec (fun (L : List (Option ℕ) × ℕ) => (L.1[L.2]?).bind (fun res => res.map Nat.succ)) := by
      convert Lambda.unbody_code_step_inner_primrec using 1;
    convert h_primrec_inner.comp ( show Primrec ( fun L : List ( Option ℕ ) => ( L, Nat.unpair ( Nat.unpair L.length ).2 |> Prod.snd ) ) from ?_ ) using 1;
    convert Primrec.pair Primrec.id ( Primrec.comp ( show Primrec ( fun x : ℕ => ( Nat.unpair ( Nat.unpair x ).2 ).2 ) from ?_ ) ( show Primrec ( fun L : List ( Option ℕ ) => L.length ) from ?_ ) ) using 1;
    · exact Primrec.snd.comp ( Primrec.unpair.comp ( Primrec.snd.comp ( Primrec.unpair.comp Primrec.id ) ) );
    · exact Primrec.list_length;
  · convert h_primrec.comp ( Primrec.list_length ) using 1;
  · unfold unbody_code_step; aesop;
    · unfold unbody_code_step_inner; aesop;
    · cases h : Nat.unpair x.length ; aesop

/-
The step function `Lambda.unbody_code_step` correctly computes `Lambda.unbody_code` given the list of previous values.
-/
theorem Lambda.unbody_code_eq_step (n : ℕ) :
  Lambda.unbody_code_step ((List.range n).map Lambda.unbody_code) = Lambda.unbody_code n := by
    unfold Lambda.unbody_code_step;
    aesop;
    · rw [ Lambda.unbody_code ];
      rw [ Nat.strongRecOn_eq ];
      unfold Lambda.unbody_code_step_inner; aesop;
    · -- Since $m$ is the second component of the pair that $n$ unpairs to, we have $m < n$.
      have h_m_lt_n : m < n := by
        unfold Nat.unpair at heq; aesop;
        · nlinarith [ Nat.sub_add_cancel ( show n.sqrt * n.sqrt ≤ n from by nlinarith [ Nat.sqrt_le n ] ) ];
        · omega;
      contrapose! h_2;
      exact lt_of_le_of_lt ( Nat.le_of_lt_succ ( Nat.lt_succ_of_le ( Nat.unpair_right_le _ ) ) ) h_m_lt_n;
    · unfold unbody_code;
      rw [ Nat.strongRecOn_eq ] ; aesop;
    · unfold Lambda.unbody_code;
      rw [ Nat.strongRecOn_eq ] ; aesop

/-
`Lambda.unbody_code` is primitive recursive.
-/
theorem Lambda.unbody_code_primrec : Primrec Lambda.unbody_code := by
  by_contra h_not_primrec;
  -- Apply the contradiction assumption to obtain the result
  apply h_not_primrec;
  have h_unbody_code_primrec : Primrec (fun n => Lambda.unbody_code n) := by
    have h_unbody_code_step_primrec : Primrec (fun L : List (Option ℕ) => Lambda.unbody_code_step L) := by
      exact Lambda.unbody_code_step_primrec
    convert Primrec.nat_strong_rec _ using 1;
    rotate_left;
    exact Unit;
    exact Option ℕ;
    all_goals try infer_instance;
    exact fun _ n => Lambda.unbody_code n;
    exact fun _ L => some ( Lambda.unbody_code_step L );
    aesop;
    · exact Primrec.option_some.comp h_unbody_code_step_primrec |> Primrec.comp <| Primrec.snd;
    · exact Lambda.unbody_code_eq_step _;
    · exact h_not_primrec <| by simpa using a.comp ( Primrec.const () ) ( Primrec.id ) ;
  exact h_unbody_code_primrec

/-
`Lambda.unchurch_code` is primitive recursive.
-/
theorem Lambda.unchurch_code_primrec : Primrec Lambda.unchurch_code := by
  -- `Lambda.unchurch_code` is defined by pattern matching on `Nat.unpair`.
  -- The structure is a composition of primitive recursive functions (unpair, conditionals, unbody_code).
  -- Therefore it is primitive recursive.
  apply Primrec.of_eq;
  convert Primrec.of_eq _ _;
  exact fun n => if n.unpair.1 = 2 then if n.unpair.2.unpair.1 = 2 then Lambda.unbody_code n.unpair.2.unpair.2 else none else none;
  exact fun n => if ( Nat.unpair n ).1 = 2 then if ( Nat.unpair ( Nat.unpair n ).2 ).1 = 2 then unbody_code ( Nat.unpair ( Nat.unpair n ).2 ).2 else none else none;
  · apply_rules [ Primrec.option_bind, Primrec.option_map, Primrec.ite, Primrec.const, Primrec.unpair ];
    · exact Primrec.eq.comp ( Primrec.fst.comp ( Primrec.unpair ) ) ( Primrec.const 2 );
    · -- The function (Nat.unpair (Nat.unpair a).2).1 is primitive recursive because it is a composition of primitive recursive functions.
      have h_comp : Primrec (fun a => (Nat.unpair (Nat.unpair a).2).1) := by
        exact Primrec.fst.comp ( Primrec.unpair.comp ( Primrec.snd.comp Primrec.unpair ) );
      convert Primrec.eq.comp ( h_comp ) ( Primrec.const 2 ) using 1;
    · convert Lambda.unbody_code_primrec.comp _ using 1;
      -- The function that takes the second element of the second element of the unpairing is primitive recursive.
      have h_unpair_snd : Primrec (fun a : ℕ => (Nat.unpair a).2) := by
        exact Primrec.snd.comp Primrec.unpair;
      exact h_unpair_snd.comp h_unpair_snd;
