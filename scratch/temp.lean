/-
Definitions of Confluence and EvalCorrectness.
-/
def Lambda.Confluence : Prop :=
  ∀ {t t1 t2 : Lambda}, Lambda.reduces t t1 → Lambda.reduces t t2 → ∃ t3, Lambda.reduces t1 t3 ∧ Lambda.reduces t2 t3

def Lambda.EvalCorrectness : Prop :=
  ∀ t n, Lambda.reduces t (Lambda.church n) ↔ Lambda.eval (Lambda.encode t) = Part.some (Lambda.church_code n)

