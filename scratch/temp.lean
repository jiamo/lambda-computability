/-
`leq` correctly computes the less-than-or-equal relation on Church numerals.
-/
theorem Lambda.leq_works (n m : ℕ) :
  Lambda.reduces (Lambda.app (Lambda.app Lambda.leq (Lambda.church n)) (Lambda.church m))
    (if n ≤ m then Lambda.true else Lambda.false) := by
      -- By definition of `leq`, we know that `leq (church n) (church m)` reduces to `(isZero (sub (church n) (church m)))`.
      have h_leq_def : (Lambda.app (Lambda.app Lambda.leq (Lambda.church n)) (Lambda.church m)).reduces (Lambda.app Lambda.isZero (Lambda.app (Lambda.app Lambda.sub (Lambda.church n)) (Lambda.church m))) := by
        constructor;
        constructor;
        constructor;
        -- Since `church n` is a closed term, substituting `isZero` for `var 1` in it leaves it unchanged.
        have h_closed : ∀ (s : Lambda) (x : ℕ), Lambda.subst s x (Lambda.church n) = Lambda.church n := by
          bound;
          -- By definition of `subst`, substituting a term into a Church numeral leaves it unchanged.
          apply Lambda.subst_church;
        -- Apply the reduction rule for application of a lambda abstraction to an argument.
        have h_beta : ∀ (f : Lambda) (x : Lambda), Lambda.reduces (Lambda.app (Lambda.lam x) f) (Lambda.subst f 0 x) := by
          intros f x; exact (by
          constructor;
          constructor;
          constructor);
        convert h_beta _ _ using 1;
        -- By definition of substitution, substituting `church n` for `var 1` in `sub` results in `sub`.
        simp [Lambda.subst];
        aesop;
      -- By definition of `isZero`, we know that `isZero (sub (church n) (church m))` reduces to `true` if `n - m = 0` and `false` otherwise.
      have h_isZero : (Lambda.app Lambda.isZero (Lambda.app (Lambda.app Lambda.sub (Lambda.church n)) (Lambda.church m))).reduces (if n - m = 0 then Lambda.true else Lambda.false) := by
        -- By definition of `sub`, we know that `sub (church n) (church m)` reduces to `church (n - m)`.
        have h_sub : (Lambda.app (Lambda.app Lambda.sub (Lambda.church n)) (Lambda.church m)).reduces (Lambda.church (n - m)) := by
          apply_rules [ Lambda.sub_works ];
        -- By definition of `isZero`, we know that `isZero (church (n - m))` reduces to `true` if `n - m = 0` and `false` otherwise.
        have h_isZero_def : (Lambda.app Lambda.isZero (Lambda.church (n - m))).reduces (if n - m = 0 then Lambda.true else Lambda.false) := by
          cases h : n - m <;> simp_all +decide [ Lambda.isZero_zero, Lambda.isZero_succ ];
        have h_isZero_step : ∀ t1 t2, Lambda.reduces t1 t2 → Lambda.reduces (Lambda.app Lambda.isZero t1) (Lambda.app Lambda.isZero t2) := by
          intros t1 t2 h_reduces
          induction' h_reduces with t1 t2 h_reduces ih;
          · constructor;
          · apply_rules [ Lambda.reduces.step, Lambda.reduces.refl ];
            constructor ; tauto;
        exact h_isZero_step _ _ h_sub |> Lambda.reduces_trans <| h_isZero_def;
      -- By transitivity of reduction, we can combine h_leq_def and h_isZero to conclude the proof.
      have h_trans : (Lambda.app (Lambda.app Lambda.leq (Lambda.church n)) (Lambda.church m)).reduces (if n ≤ m then Lambda.true else Lambda.false) := by
        have h_trans : (Lambda.app (Lambda.app Lambda.leq (Lambda.church n)) (Lambda.church m)).reduces (Lambda.app Lambda.isZero (Lambda.app (Lambda.app Lambda.sub (Lambda.church n)) (Lambda.church m))) := h_leq_def
        have h_trans' : (Lambda.app Lambda.isZero (Lambda.app (Lambda.app Lambda.sub (Lambda.church n)) (Lambda.church m))).reduces (if n ≤ m then Lambda.true else Lambda.false) := by
          aesop;
          omega
        -- By transitivity of reduction, we can combine h_trans and h_trans' to conclude the proof.
        apply Lambda.reduces_trans h_trans h_trans';
      exact h_trans

