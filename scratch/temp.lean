  · unfold Lambda.unchurch_code; aesop;
    · exact False.elim <| x_1 _ <| Prod.ext h_1 rfl;
    · cases h_1' : Nat.unpair n ; aesop

/-
`Lambda.unbody_code` correctly decodes the body of a Church numeral.
-/
theorem Lambda.unbody_code_correct (n : ℕ) : Lambda.unbody_code (Lambda.body_code n) = some n := by
  induction' n with n ih;
  · simp ( config := { decide := Bool.true } ) [ Lambda.unbody_code, Lambda.body_code ];
  · -- By definition of `body_code`, we have `body_code (n + 1) = app_code (Nat.pair 0 1) (body_code n)`.
    have h_body_code_succ : body_code (n + 1) = app_code (Nat.pair 0 1) (body_code n) := by
      rfl;
    unfold app_code at * ; aesop;
    unfold unbody_code;
    rw [ Nat.strongRecOn_eq ] ; aesop

