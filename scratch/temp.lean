theorem Lambda.seq_apply_closed (G : Lambda) (hG : Lambda.IsClosed G) : Lambda.IsClosed (Lambda.seq_apply G) := by
  -- By definition of `seq_apply`, we know that `seq_apply G` is closed because `G` is closed and the composition of closed terms is closed.
  simp [Lambda.IsClosed, Lambda.seq_apply];
  -- By definition of `seq_apply_body`, we know that `seq_apply_body G` is closed because `G` is closed and the composition of closed terms is closed.
  simp [Lambda.IsClosed, Lambda.seq_apply_inner, Lambda.seq_apply_arg, Lambda.seq_apply_body] at *;
  -- By definition of `subst`, we know that substituting into a lambda term results in the same lambda term.
  intros s x
  apply Eq.symm;
  congr;
  · -- By definition of `lift`, we know that `lift 2 0 G` is closed because `G` is closed.
    have h_lift_closed : ∀ (n k : ℕ), Lambda.IsClosed G → Lambda.lift n k G = G := by
      intros n k hG'; exact Lambda.lift_closed hG' n k;
    rw [ h_lift_closed ];
    · exact (hG s (x + 1 + 1)).symm;
    · exact hG;
  · -- Since lifting a term with respect to 0 doesn't change it, we have lift 1 0 G = G.
    have h_lift : lift 1 0 G = G := by
      exact Lambda.lift_closed hG 1 0;
    grind

theorem Lambda.comp_term_closed (F G : Lambda) (hF : Lambda.IsClosed F) (hG : Lambda.IsClosed G) : Lambda.IsClosed (Lambda.comp_term F G) := by
  -- Apply the fact that `Lift` preserves closedness when the term is closed and the lift amount is non-negative.
  have h_lift_closed : ∀ (t : Lambda) (n k : ℕ), Lambda.IsClosed t → Lambda.IsClosed (Lambda.lift n k t) := by
    -- By definition of `IsClosed`, if `t` is closed, then for any index `k`, `t` is closed.
    intros t n k ht
    simp [Lambda.IsClosed] at ht
    generalize_proofs at *; (
    -- By definition of `IsClosed`, if `t` is closed, then for any index `k`, `t` is closed. Therefore, `lift n k t` is also closed.
    apply Lambda.lift_closed ht n k |> fun h => by
      -- Since `lift � n� k t` is equal to `t`, and `t` is closed by `ht`, we can conclude that `lift n k t` is closed.
      rw [h]
      exact ht
      skip
    skip)
  generalize_proofs at *; (
  -- Apply the fact that `Lift` preserves closedness when the term is closed and the lift amount is non-negative to each part of the term.
  have h_lift_closed_F : Lambda.IsClosed (Lambda.lift 1 0 F) := by
    exact h_lift_closed F 1 0 hF
  have h_lift_closed_G : Lambda.IsClosed (Lambda.lift 1 0 G) := by
    exact h_lift_closed _ _ _ hG
  have h_lift_closed_seq_apply : Lambda.IsClosed (Lambda.seq_apply G) := by
    exact Lambda.seq_apply_closed G hG
  generalize_proofs at *; (
  intro x; simp_all +decide [ Lambda.comp_term ] ;
  intro n; exact (by
  exact congr_arg _ ( congr_arg₂ _ ( h_lift_closed_seq_apply _ _ ) ( congr_arg₂ _ ( h_lift_closed _ _ _ hF _ _ ) ( by simp +decide [ Lambda.subst ] ) ) ));))

def Lambda.closeAt (k : ℕ) : Lambda → Lambda
  | Lambda.var i => if i < k then Lambda.var i else Lambda.church 0
  | Lambda.app t1 t2 => Lambda.app (Lambda.closeAt k t1) (Lambda.closeAt k t2)
  | Lambda.lam t => Lambda.lam (Lambda.closeAt (k + 1) t)

def Lambda.close (t : Lambda) : Lambda := Lambda.closeAt 0 t

theorem Lambda.closeAt_is_closedAt (t : Lambda) (k : ℕ) : Lambda.IsClosedAt (Lambda.closeAt k t) k := by
  -- By definition of `closeAt`, we know that `closeAt k t` is closed at `k` because any variable with index less than `k` is replaced by a Church numeral, which is closed.
  induction' t with n t1 t2 ih1 ih2 t ih generalizing k;
  · -- By definition of `closeAt`, if `n < k`, then `closeAt k (var n)` is a Church numeral, which is closed at `k`.
    simp [Lambda.closeAt];
    split_ifs with h;
    · intro s x hx; simp [Lambda.subst]; omega;
    · intro s x hx; exact Lambda.church_closed 0 s x;
  · -- By definition of `closeAt`, if `ih1` and `ih2` are closed at `k`, then their application is also closed at `k`.
    have h_closed_app : ∀ (t1 t2 : Lambda), t1.IsClosedAt k → t2.IsClosedAt k → (t1.app t2).IsClosedAt k := by
      intros t1 t2 h1 h2 s x hx; simp [Lambda.subst, h1 s x hx, h2 s x hx];
    exact h_closed_app _ _ ( by solve_by_elim ) ( by solve_by_elim );
  · unfold Lambda.closeAt;
    intro s x hx; simp [Lambda.subst]; exact ih (k + 1) s (x + 1) (by omega)

theorem Lambda.close_is_closed (t : Lambda) : Lambda.IsClosed (Lambda.close t) := by
  -- By definition of `close`, we know that `close t` is closed because `closeAt 0 t` is closed at 0.
  have h_closed : Lambda.IsClosedAt (Lambda.closeAt 0 t) 0 := by
    -- By definition of `closeAt`, we know that `closeAt 0 t` is closed at 0.
    apply Lambda.closeAt_is_closedAt
  generalize_proofs at *; (
  intro s x; exact h_closed s x (Nat.zero_le x))

theorem Lambda.lift_closeAt_generalized (t : Lambda) (j k : ℕ) :
  Lambda.lift 1 j (Lambda.closeAt (k + j) t) = Lambda.closeAt (k + j + 1) (Lambda.lift 1 j t) := by
    have h_lift_closeAt : ∀ t : Lambda, ∀ k j : ℕ, Lambda.lift 1 j (Lambda.closeAt (k + j) t) = Lambda.closeAt (k + j + 1) (Lambda.lift 1 j t) := by
      intros t k j;
      -- By definition of `lift`, we know that `lift 1 j (closeAt (k + j) t) = closeAt (k + j + 1) (lift 1 j t)` follows directly from the definition of `lift`.
      have h_lift : ∀ t : Lambda, ∀ k j : ℕ, Lambda.lift 1 j (Lambda.closeAt (k + j) t) = Lambda.closeAt (k + j + 1) (Lambda.lift 1 j t) := by
        -- By definition of `lift` and `closeAt`, we can prove this by induction on the structure of `t`.
        intros t k j
        induction' t with t ih generalizing k j;
        · unfold Lambda.closeAt Lambda.lift; simp +decide [ Nat.add_comm, Nat.add_left_comm, Nat.add_assoc ] ;
          split_ifs <;> simp_all +decide [ Nat.lt_succ_iff ];
          · intros; linarith;
          · grind;
          · linarith;
          · exact Eq.symm ( if_neg ( by linarith ) );
        · -- By definition of `lift`, we can distribute it over the application.
          have h_lift_app : ∀ t1 t2 : Lambda, ∀ j : ℕ, Lambda.lift 1 j (Lambda.app t1 t2) = Lambda.app (Lambda.lift 1 j t1) (Lambda.lift 1 j t2) := by
            -- By definition of `lift`, we can distribute it over the application. Use the definition of `lift` for applications.
            intros t1 t2 j
            rw [Lambda.lift];
          -- By definition of `closeAt`, we can distribute it over the application.
          have h_closeAt_app : ∀ t1 t2 : Lambda, ∀ k : ℕ, Lambda.closeAt k (Lambda.app t1 t2) = Lambda.app (Lambda.closeAt k t1) (Lambda.closeAt k t2) := by
            intros t1 t2 k; rfl;
          grind;
        · unfold lift closeAt; aesop;
      exact h_lift t k j;
    exact h_lift_closeAt t k j

def Lambda.omega : Lambda := Lambda.app (Lambda.lam (Lambda.app (Lambda.var 0) (Lambda.var 0))) (Lambda.lam (Lambda.app (Lambda.var 0) (Lambda.var 0)))

theorem Lambda.step_omega_omega : Lambda.step Lambda.omega Lambda.omega := by
  -- By definition of omega, we have omega = (\x. x x) (\x. x x). Therefore, omega.step omega follows directly from the definition of step.
  apply Lambda.step.beta

theorem Lambda.omega_reduces_omega : Lambda.reduces Lambda.omega Lambda.omega := by
  -- By definition of `reduces`, we need to show that `omega` reduces to itself through a series of steps. We can use the fact that `omega` reduces to itself in one step.
  apply Lambda.reduces.refl

theorem Lambda.step_omega_eq (t : Lambda) (h : Lambda.step Lambda.omega t) : t = Lambda.omega := by
  -- Since omega is a fixed point, any step from omega must be omega itself.
  have h_omega_fixed : ∀ t, Lambda.step Lambda.omega t → t = Lambda.omega := by
    -- By definition of omega, we know that omega steps to itself. Therefore, if omega steps to t, then t must be omega.
    intros t ht
    have h_eq : t = omega := by
      cases ht <;> tauto
    exact h_eq;
  -- Apply the hypothesis `h_omega_fixed` to `h` to conclude that `t = omega`.
  apply h_omega_fixed; assumption

theorem Lambda.closeAt_eq_self_of_closedAt (t : Lambda) (k : ℕ) (h : Lambda.IsClosedAt t k) : Lambda.closeAt k t = t := by
  -- By definition of `closeAt`, if `t` is closed at `k`, then `closeAt k t` is just `t` itself.
  induction' t with n t1 t2 ih1 ih2 t ih generalizing k;
  · cases lt_or_ge n k <;> simp_all +decide [ Lambda.IsClosedAt ];
    · unfold Lambda.closeAt; aesop;
    · exact absurd ( h ( var ( n + 1 ) ) n ( by linarith ) ) ( by simp +decide [ Lambda.subst ] );
  · -- By the induction hypothesis, we know that closeAt k t1 = t1 and closeAt k t2 = t2.
    have h_ind_ih : closeAt k t1 = t1 := by
      exact ih1 k (fun s x hx => by have := h s x hx; unfold Lambda.subst at this; aesop);
    have h_ind_a : closeAt k t2 = t2 := by
      exact ih2 k (fun s x hx => by have := h s x hx; unfold Lambda.subst at this; aesop);
    exact congr_arg₂ _ h_ind_ih h_ind_a;
  · -- By definition of `IsClosedAt`, if `t.lam` is closed at `k`, then `t` is closed at `k + 1`.
    have h_closed : ∀ (t : Lambda) (k : ℕ), Lambda.IsClosedAt (Lambda.lam t) k ↔ Lambda.IsClosedAt t (k + 1) := by
      -- By definition of `IsClosedAt`, if `t.lam` is closed at `k`, then `t` is closed at `k + 1` by definition.
      intros t k
      simp [Lambda.IsClosedAt];
      constructor <;> intro h s x hx;
      · specialize h s ( x - 1 ) ( by omega ) ; rcases x with ( _ | x ) <;> simp_all +decide [ Nat.sub_add_cancel ] ;
        unfold Lambda.subst at h; aesop;
      · -- By definition of substitution for lambda terms, we have s.subst x (t.lam) = (s.subst (x + 1) t).lam.
        have h_subst_lam : s.subst x (t.lam) = (s.subst (x + 1) t).lam := by
          rfl;
        rw [ h_subst_lam, h s ( x + 1 ) ( by linarith ) ];
    unfold closeAt; aesop;

theorem Lambda.lift_subst_var (s : Lambda) (n k x y : ℕ) (h : k ≤ x) :
  Lambda.lift n k (Lambda.subst s x (Lambda.var y)) = Lambda.subst (Lambda.lift n k s) (x + n) (Lambda.lift n k (Lambda.var y)) := by
    -- By definition of substitution, we have two cases: $x = y$ or $x \neq y$.
    by_cases hxy : x = y;
    · -- By definition of substitution, substituting y with itself in s doesn't change s.
      have h_subst_self : s.subst y (var y) = s := by
        simp [Lambda.subst];
      -- By definition of substitution, substituting x with itself in s doesn't change s.
      have h_subst_self : (lift n k s).subst (x + n) (lift n k (var x)) = lift n k s := by
        rw [ show lift n k ( var x ) = var ( x + n ) from by
              exact if_neg ( by linarith ) ];
        simp [Lambda.subst];
      aesop;
    · -- By definition of substitution, substituting y into s gives us a new term where y is replaced by s.
      have h_subst : s.subst x (var y) = if x = y then s else var y := by
        -- By definition of substitution, substituting y into s gives us a new term where y is replaced by s. Since x ≠ y, the substitution is just var y.
        simp [Lambda.subst, hxy];
      -- By definition of lift, we have two cases: $y < k$ or $y \geq k$.
      by_cases hyk : y < k;
      · -- Since y < k, lifting var y by n at k results in var y because lifting doesn't change the variable when the index is within the scope.
        have h_lift_var : lift n k (var y) = var y := by
          exact if_pos hyk;
        cases s <;> simp_all +decide [ Lambda.subst ];
        · grind;
        · exact fun h => False.elim <| hxy <| by linarith;
        · grind;
      · -- By definition of lift, we have two cases: $y \geq k$ or $y < k$.
        have h_lift : lift n k (var y) = var (y + n) := by
          exact if_neg hyk;
        -- Since y is not less than k, we have y + n ≥ k + n. Therefore, substituting x + n into var (y + n) gives us var (y + n) because x + n is not equal to y + n.
        have h_subst_lift : (lift n k s).subst (x + n) (var (y + n)) = var (y + n) := by
          exact if_neg ( by omega );
        grind

theorem Lambda.lift_subst_of_closed (s t : Lambda) (n k x : ℕ) (h : k ≤ x) (hs : Lambda.IsClosed s) :
  Lambda.lift n k (Lambda.subst s x t) = Lambda.subst s (x + n) (Lambda.lift n k t) := by
    have h_lift_subst_closed : ∀ t : Lambda, ∀ n k x : ℕ, k ≤ x → Lambda.lift n k (Lambda.subst s x t) = Lambda.subst (Lambda.lift n k s) (x + n) (Lambda.lift n k t) := by
      intros t n k x h;
      induction' t with t t ih generalizing k x;
      · exact Lambda.lift_subst_var s n k x t h;
      · -- By definition of lift and subst, we can rewrite the left-hand side and right-hand side of the equation.
        have h_lhs : lift n k (s.subst x (t.app ih)) = (lift n k (s.subst x t)).app (lift n k (s.subst x ih)) := by
          rfl
        have h_rhs : (lift n k s).subst (x + n) (lift n k (t.app ih)) = ((lift n k s).subst (x + n) (lift n k t)).app ((lift n k s).subst (x + n) (lift n k ih)) := by
          rfl;
        aesop;
      · convert congr_arg Lambda.lam ( ‹∀ k x, k ≤ x → lift n k ( s.subst x _ ) = ( lift n k s ).subst ( x + n ) ( lift n k _ ) › ( k + 1 ) ( x + 1 ) ( by linarith ) ) using 1;
        rw [ show lift n k s = s from Lambda.lift_closed hs n k ] ; simp +decide [ add_comm, add_left_comm, add_assoc ] ;
        rw [ show lift n ( k + 1 ) s = s from Lambda.lift_closed hs n (k + 1) ];
        simp [Lambda.subst, Lambda.lift, add_comm, add_left_comm, add_assoc];
    rw [ h_lift_subst_closed t n k x h, show Lambda.lift n k s = s from ?_ ];
    exact Lambda.lift_closed hs n k

theorem Lambda.lift_subst_var_of_closed (s : Lambda) (n k x y : ℕ) (h : k ≤ x) (hs : Lambda.IsClosed s) :
  Lambda.lift n k (Lambda.subst s x (Lambda.var y)) = Lambda.subst s (x + n) (Lambda.lift n k (Lambda.var y)) := by
    -- Apply the lemma that states `lift n k (s.subst x (var y))` equals `s.subst (x + n) (lift n k (var y))` for any closed term `s`, given that `s` is closed at `x`.
    apply Lambda.lift_subst_of_closed s (var y) n k x h hs

theorem Lambda.lift_lift (s : Lambda) (n k : ℕ) :
  Lambda.lift n (k + 1) (Lambda.lift 1 0 s) = Lambda.lift 1 0 (Lambda.lift n k s) := by
    -- Apply the generalized lemma `lift_lift_generalized` with `j = 0`.
    have h_apply_generalized : ∀ s : Lambda, ∀ n k : ℕ, ∀ j : ℕ, j ≤ k → Lambda.lift n (k + 1) (Lambda.lift 1 j s) = Lambda.lift 1 j (Lambda.lift n k s) := by
      intros s n k j hj
      apply Eq.symm;
      induction' s with s ih generalizing n k j;
      · unfold lift;
        unfold lift; split_ifs <;> simp_all +arith +decide;
        · grind;
        · linarith;
        · grind;
      · exact congr_arg₂ _ ( ‹∀ ( n k j : ℕ ), j ≤ k → lift 1 j ( lift n k ih ) = lift n ( k + 1 ) ( lift 1 j ih ) › n k j hj ) ( ‹∀ ( n k j : ℕ ), j ≤ k → lift 1 j ( lift n k _ ) = lift n ( k + 1 ) ( lift 1 j _ ) › n k j hj );
      · rename_i a ha;
        exact congr_arg Lambda.lam ( by simpa using ha n ( k + 1 ) ( j + 1 ) ( by linarith ) );
    rw [ h_apply_generalized s n k 0 bot_le ]


