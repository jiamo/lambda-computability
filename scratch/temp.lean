/-
`false x y` reduces to `y`.
-/
theorem Lambda.false_works (x y : Lambda) : Lambda.reduces (Lambda.app (Lambda.app Lambda.false x) y) y := by
  -- By definition of `false`, we have `false = \f x. x`.
  have h_false : Lambda.false = Lambda.lam (Lambda.lam (Lambda.var 0)) := by
    rfl;
  -- By definition of `beta`, we have `Lambda.app (Lambda.app (Lambda.lam (Lambda.lam (Lambda.var 0))) x) y` reduces to `Lambda.app (Lambda.lam (Lambda.var 0)) y`.
  have h_beta : Lambda.reduces (Lambda.app (Lambda.app (Lambda.lam (Lambda.lam (Lambda.var 0))) x) y) (Lambda.app (Lambda.lam (Lambda.var 0)) y) := by
    exact .step _ _ _ ( by tauto ) ( .refl _ );
  aesop;
  -- By definition of `reduces`, we can apply the beta reduction rule directly.
  apply Lambda.reduces_trans h_beta;
  exact .step _ _ _ ( .beta _ _ ) ( .refl _ )

/-
`true x y` reduces to `x` for closed `x`.
