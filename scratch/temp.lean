/-
Substitution into a Church numeral (which is a closed term) is the identity.
-/
theorem Lambda.subst_church (s : Lambda) (k : ℕ) (n : ℕ) : Lambda.subst s k (Lambda.church n) = Lambda.church n := by
  unfold Lambda.church;
  induction' n with n ih generalizing k <;> simp_all +decide [ List.range_succ ];
  · simp [Lambda.subst]
  · simp_all +decide [ Lambda.subst ]

/-
`Lambda.mult_aux n m` reduces to `Lambda.church (n * m)`.
-/
def Lambda.mult_aux (n m : ℕ) := Lambda.lam (Lambda.lam (Lambda.iterate (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0) n))

theorem Lambda.mult_aux_reduces_church (n m : ℕ) :
  Lambda.reduces (Lambda.mult_aux n m) (Lambda.church (n * m)) := by
    -- Apply the hypothesis `h_subst` to the term `Lambda.app (Lambda.var 3) (Lambda.var 1)`.
    have h_apply : Lambda.reduces (Lambda.iterate (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0) n) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (n * m)) := by
      exact Lambda.iterate_mul_term n m
    apply_rules [ Lambda.reduces_lam ]

/-
`Lambda.mult (church n) (church m)` reduces to `Lambda.mult_step1 n m`.
-/
def Lambda.mult_step1 (n m : ℕ) := Lambda.lam (Lambda.lam (Lambda.app (Lambda.app (Lambda.church n) (Lambda.app (Lambda.church m) (Lambda.var 1))) (Lambda.var 0)))

theorem Lambda.mult_reduces_to_step1 (n m : ℕ) :
  Lambda.reduces (Lambda.app (Lambda.app Lambda.mult (Lambda.church n)) (Lambda.church m)) (Lambda.mult_step1 n m) := by
    constructor;
    any_goals constructor;
    any_goals tauto;
    unfold mult_step1;
    simp +decide [ Lambda.subst ];
    rw [ Lambda.subst_church ];
    constructor


/-
Transitivity of reduction.
-/
theorem Lambda.reduces_trans {t1 t2 t3 : Lambda} (h1 : Lambda.reduces t1 t2) (h2 : Lambda.reduces t2 t3) : Lambda.reduces t1 t3 := by
  induction h1 <;> induction h2 <;> tauto

/-
`mult_step1` reduces to `mult_aux`.
-/
theorem Lambda.mult_step1_reduces_to_mult_aux (n m : ℕ) : Lambda.reduces (Lambda.mult_step1 n m) (Lambda.mult_aux n m) := by
  -- Apply the church_reduces_iterate theorem with f being (app (church m) (var 1)) and x being (var 0).
  have h_apply : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) (Lambda.app (Lambda.church m) (Lambda.var 1))) (Lambda.var 0)) (Lambda.iterate (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0) n) := by
    have h_subst : Lambda.subst (Lambda.var 0) 0 (Lambda.app (Lambda.church m) (Lambda.var 1)) = Lambda.app (Lambda.church m) (Lambda.var 1) := by
      unfold Lambda.subst; aesop;
      unfold Lambda.subst; simp ( config := { decide := Bool.true } ) ;
      unfold Lambda.subst; simp ( config := { decide := Bool.true } ) [ church ] ;
      induction' ( List.range m ) using List.reverseRecOn with m ih <;> aesop;
      unfold Lambda.subst; aesop;
    have := @Lambda.church_reduces_iterate n ( Lambda.app ( Lambda.church m ) ( Lambda.var 1 ) ) ( Lambda.var 0 ) ; aesop;
  apply_rules [ Lambda.reduces_lam ]

/-
Multiplication works on Church numerals.
-/
theorem Lambda.mult_works (n m : ℕ) : Lambda.reduces (Lambda.app (Lambda.app Lambda.mult (Lambda.church n)) (Lambda.church m)) (Lambda.church (n * m)) := by
  -- By transitivity, we can chain these reductions together.
  apply Lambda.reduces_trans; exact Lambda.mult_reduces_to_step1 n m; exact Lambda.reduces_trans (Lambda.mult_step1_reduces_to_mult_aux n m) (Lambda.mult_aux_reduces_church n m)

/-
`isZero` applied to `church 0` reduces to `true`.
