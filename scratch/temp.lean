  have h_or_true_true : Lambda.reduces (Lambda.app (Lambda.app Lambda.or Lambda.true) Lambda.true) Lambda.true := by
    have h_def : Lambda.or = Lambda.lam (Lambda.lam (Lambda.app (Lambda.app (Lambda.var 1) Lambda.true) (Lambda.var 0))) := by
