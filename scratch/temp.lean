/-
If `f` simulates `g` via `m`, then the image of the fixpoint of `g` is contained in the fixpoint of `f`.
-/
theorem PFun.fix_map_subset_forward {α β} (f : α →. α ⊕ α) (g : β →. β ⊕ β) (m : β → α)
  (h : ∀ b, f (m b) = (g b).map (Sum.map m m)) :
  ∀ b y, y ∈ PFun.fix g b → m y ∈ PFun.fix f (m b) := by
    intro b y hy;
    have := @PFun.fixInduction β;
    specialize this ( show y ∈ g.fix b from hy ) ( fun a' ha' ih => ?_ );
    use fun a' => m y ∈ f.fix ( m a' );
    · rw [ PFun.mem_fix_iff ] at *;
      cases' ha' with ha' ha' <;> simp_all +decide [ Part.map ];
      · cases' ha' with ha' ha' ; aesop;
      · cases' ha' with a'' ha'';
        exact Or.inr ⟨ m a'', ⟨ ha''.1.1, by simp +decide [ ha''.1.2 ] ⟩, ih a'' ha''.1 ⟩;
    · exact this


