  have h_list_get : Primrec (fun x : List (Option ℕ) × ℕ => x.1[x.2]?) := by
    -- The function `fun x : List ℕ × ℕ => x.1[x.2]?` is primitive recursive by definition.
    apply Primrec.list_getElem?;
