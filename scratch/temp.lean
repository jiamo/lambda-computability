theorem Lambda.subst_ecf_eq_step (s_code : ℕ) (n : ℕ) :
  Lambda.subst_ecf_step s_code ((List.range n).map (Lambda.subst_ecf s_code)) = some (Lambda.subst_ecf s_code n) := by
