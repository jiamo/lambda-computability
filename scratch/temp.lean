theorem Lambda.subst_ecf_primrec : Primrec₂ Lambda.subst_ecf := by
  -- Apply the induction hypothesis with the functions `f` and `g`.
  apply Primrec.nat_strong_rec;
  -- The function `g` is primitive recursive by definition.
  apply Lambda.subst_ecf_step_primrec;
  -- By definition of `subst_ecf`, we know that `subst_ecf_step a (List.map (subst_ecf a) (List.range n)) = some (subst_ecf a n)`.
