/-
Lifting commutes with substitution for closed s.
-/
theorem Lambda.lift_subst (s t : Lambda) (n k x : ℕ) (h : k ≤ x) (hs : Lambda.IsClosed s) :
  Lambda.lift n k (Lambda.subst s x t) = Lambda.subst (Lambda.lift n k s) (x + n) (Lambda.lift n k t) := by
    convert Lambda.lift_subst_of_closed s t n k x h hs using 1;
    -- Since $s$ is closed, $lift n k s = s$ by definition of lift and the fact that $s$'s variables do not depend on $k$ or $n$.
    have h_lift_closed : s.IsClosed → lift n k s = s := by
      exact fun h => Lambda.lift_closed h n k;
    rw [ h_lift_closed hs ]

