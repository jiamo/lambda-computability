def mk_var_ecf (s_code : ℕ) (y : ℕ) : ECF :=
  let d := Lambda.var_code y
  let L := (List.replicate y d) ++ [s_code]
  (L, d)

theorem mk_var_ecf_primrec : Primrec₂ mk_var_ecf := by
  have h_mk_var_ecf_primrec : Primrec (fun p : ℕ × ℕ => List.replicate p.2 (Lambda.var_code p.2) ++ [p.1]) := by
    have h_append : Primrec (fun (p : ℕ × ℕ) => List.replicate p.2 (Lambda.var_code p.2)) := by
      have h_list_append : Primrec (fun (p : ℕ × ℕ) => List.replicate p.2 p.1) := by
        have h_list_replicate : Primrec (fun p : ℕ × ℕ => List.replicate p.2 p.1) := by
          have h_list_replicate_aux : ∀ p : ℕ × ℕ, List.replicate p.2 p.1 = List.map (fun _ => p.1) (List.range p.2) := by
            aesop
          simp +decide only [h_list_replicate_aux];
          apply Primrec.list_map;
          · exact Primrec.list_range.comp ( Primrec.snd );
          · exact Primrec.fst.comp ( Primrec.fst );
        exact h_list_replicate;
      convert h_list_append.comp _ using 1;
      rotate_left;
      exact fun p => ( Lambda.var_code p.2, p.2 );
      · exact Primrec.pair ( Lambda.var_code_primrec.comp ( Primrec.snd ) ) ( Primrec.snd );
      · rfl;
    have h_append : Primrec (fun (p : ℕ × ℕ) => List.replicate p.2 (Lambda.var_code p.2) ++ [p.1]) := by
      have h_append : Primrec (fun (p : ℕ × ℕ) => List.replicate p.2 (Lambda.var_code p.2)) := h_append
      have h_singleton : Primrec (fun (p : ℕ × ℕ) => [p.1]) := by
        exact Primrec.list_cons.comp ( Primrec.fst ) ( Primrec.const [] )
      exact Primrec.list_append.comp h_append h_singleton;
    exact h_append;
  exact Primrec.pair h_mk_var_ecf_primrec ( Primrec.comp ( Primrec.const 0 ) ( Primrec.fst ) |> Primrec.pair <| Primrec.snd ) |> Primrec.comp <| by exact Primrec.pair ( Primrec.fst ) ( Primrec.snd ) ;

