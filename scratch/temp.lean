theorem Lambda.pair_res_closed_eq (t1 t2 : Lambda) (h1 : Lambda.IsClosed t1) :
  Lambda.pair_res t1 t2 = Lambda.lam (Lambda.app (Lambda.app (Lambda.var 0) t1) t2) := by
    contrapose! h1;
    convert h1 using 1;
    constructor <;> intro h <;> rw [ eq_comm ] at * <;> simp_all +decide [ Lambda.IsClosedAt ];
    exact absurd ( h1 ) ( by unfold Lambda.pair_res; aesop )


