def Lambda.code_step'_sound_prop (t : Lambda) : Prop :=
  match Lambda.code_step' (Lambda.encode t) with
  | some c' => ∃ t', Lambda.encode t' = c' ∧ Lambda.step t t'
  | none => ∀ t', ¬ Lambda.step t t'

theorem Lambda.code_step'_sound_lam (t : Lambda) (ih : Lambda.code_step'_sound_prop t) :
  Lambda.code_step'_sound_prop (Lambda.lam t) := by
    -- Unfold `code_step'_sound_prop` for `lam t`.
    unfold Lambda.code_step'_sound_prop at *;
    -- By definition of `code_step'`, we know that `code_step' (encode (lam t)) = step_code_case2 ((List.range (encode (lam t))).map code_step')`.
    have h_code_step_lam : Lambda.code_step' (Lambda.encode (Lambda.lam t)) = (Lambda.step_code_case2 ((List.range (Lambda.encode (Lambda.lam t))).map Lambda.code_step')).join := by
      convert Lambda.code_step'_eq ( Lambda.encode ( Lambda.lam t ) ) using 1;
      unfold Lambda.step_code';
      unfold Lambda.encode; aesop;
    -- By definition of `step_code_case2`, we know that `step_code_case2 ((List.range (encode (lam t))).map code_step') = some (some (lam_code (code_step' (encode t))))` if `code_step' (encode t) = some c'`.
    have h_step_code_case2 : Lambda.step_code_case2 ((List.range (Lambda.encode (Lambda.lam t))).map Lambda.code_step') = match Lambda.code_step' (Lambda.encode t) with
      | some c' => some (some (Lambda.lam_code c'))
      | none => some none := by
        rw [ step_code_case2_eq ];
        aesop;
        · rw [ show ( Nat.unpair t.lam.encode ).2 = t.encode from ?_ ] ; aesop;
          unfold Lambda.encode; aesop;
        · rw [ show ( Nat.unpair t.lam.encode ).2 = t.encode from ?_ ];
          · unfold step_code_case2_inner; aesop;
          · unfold Lambda.encode; aesop;
        · contrapose! h;
          unfold Lambda.encode; simp +decide [ Nat.unpair_pair ] ;
          unfold Nat.pair; simp +decide [ Nat.lt_succ_iff ] ;
          split_ifs <;> nlinarith;
        · unfold Lambda.encode at h; aesop;
          norm_num [ Nat.pair ] at h;
          split_ifs at h <;> nlinarith;
    aesop;
    · use Lambda.lam w;
      exact ⟨ rfl, by constructor; assumption ⟩;
    · cases a ; tauto

theorem Lambda.code_step'_sound_var (n : ℕ) :
  Lambda.code_step'_sound_prop (Lambda.var n) := by
    -- By definition of code_step', we know that if t is a variable, then code_step' (encode t) returns none.
    simp [Lambda.code_step'_sound_prop];
    rw [ show code_step' ( var n |> Lambda.encode ) = none from ?_ ] ; aesop;
    · cases a;
    · unfold code_step';
      unfold step_code';
      unfold Lambda.encode;
      rw [ Nat.strongRecOn_eq ];
      simp +zetaDelta at *


theorem Lambda.code_step'_beta (t1_body t2 : Lambda) :
  Lambda.code_step' (Lambda.encode (Lambda.app (Lambda.lam t1_body) t2)) =
  some (Lambda.encode (Lambda.subst t2 0 t1_body)) := by
    have h_step : (Lambda.code_step' (Lambda.encode (Lambda.app (Lambda.lam t1_body) t2))) = (Lambda.step_code' ((List.range (Lambda.encode (Lambda.app (Lambda.lam t1_body) t2))).map Lambda.code_step')).join := by
