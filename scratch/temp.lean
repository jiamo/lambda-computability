/-
Lifting a Church numeral (which is a closed term) results in the same Church numeral.
-/
theorem Lambda.lift_church (n k m : ℕ) : Lambda.lift n k (Lambda.church m) = Lambda.church m := by
  apply Lambda.lift_closed; apply Lambda.church_closed;

