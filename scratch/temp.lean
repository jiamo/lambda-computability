    exact Primrec.pair ( Primrec.fst ) ( Primrec.snd.comp ( Primrec.snd ) );
  · convert Lambda.step_code_case1_right_primrec using 1;
    unfold Primrec₂; aesop;
    · convert Lambda.step_code_case1_right_primrec using 1;
    · convert a.comp _ using 1;
      rotate_left;
      exact fun p => ( p.1.2.1, p.2 );
      · exact Primrec.pair ( Primrec.fst.comp ( Primrec.snd.comp Primrec.fst ) ) Primrec.snd;
      · exact funext fun p => by cases p.2 <;> rfl;

/-
Definition of Lambda.step_code_case1_inner.
-/
def Lambda.step_code_case1_inner (L : List (Option ℕ)) (c1 c2 : ℕ) (res1 : Option ℕ) : Option (Option ℕ) :=
  match res1 with
  | some c1' => some (some (Lambda.app_code c1' c2))
  | none => (L[c2]?).bind (Lambda.step_code_case1_right c1)

/-
Lambda.step_code_case1_inner is primitive recursive.
-/
theorem Lambda.step_code_case1_inner_primrec : Primrec (fun x : (List (Option ℕ) × ℕ × ℕ) × Option ℕ => Lambda.step_code_case1_inner x.1.1 x.1.2.1 x.1.2.2 x.2) := by
  convert Primrec.option_casesOn ( show Primrec ( fun x: ( List ( Option ℕ ) × ℕ × ℕ ) × Option ℕ => x.2 ) from ?_ ) ( show Primrec ( fun x: ( List ( Option ℕ ) × ℕ × ℕ ) × Option ℕ => ( x.1.1[x.1.2.2]? ).bind ( step_code_case1_right x.1.2.1 ) ) from ?_ ) ( show Primrec₂ ( fun x: ( List ( Option ℕ ) × ℕ × ℕ ) × Option ℕ => fun c1' => some ( some ( app_code c1' x.1.2.2 ) ) ) from ?_ ) using 1;
  · exact funext fun x => by cases x.2 <;> rfl;
  · exact Primrec.snd;
  · convert Lambda.step_code_case1_inner_none_case_primrec using 1;
    unfold step_code_case1_inner_none_case; aesop;
    · convert a.comp ( show Primrec ( fun x : ( List ( Option ℕ ) × ℕ × ℕ ) => ( x, none ) ) from ?_ ) using 1;
      exact Primrec.pair ( Primrec.id ) ( Primrec.const none );
    · convert a.comp ( Primrec.fst ) using 1;
  · -- The function that takes x and c1' and returns some (some (app_code c1' x.1.2.2)) is primitive recursive because it's a composition of primitive recursive functions.
    have h_comp : Primrec (fun x : (List (Option ℕ) × ℕ × ℕ) × ℕ => some (some (app_code x.2 x.1.2.2))) := by
      have h_some : Primrec₂ (fun x y => some (some (app_code x y))) := by
        exact Primrec.option_some.comp ( Primrec.option_some.comp ( Lambda.app_code_primrec ) );
      convert h_some.comp _ _ using 1;
      · exact Primrec.snd;
      · exact Primrec.snd.comp ( Primrec.snd.comp ( Primrec.fst ) );
    exact h_comp.comp ( Primrec.fst.comp ( Primrec.fst.comp ( Primrec.id ) ) |> Primrec.pair <| Primrec.snd.comp ( Primrec.id ) )

/-
Helper function for the beta reduction case of `step_code_case1` and its Primrec proof.
-/
def Lambda.step_code_case1_beta (c1 c2 : ℕ) : Option (Option ℕ) :=
  some (some (Lambda.subst_code c2 0 c1.unpair.2))

theorem Lambda.step_code_case1_beta_primrec : Primrec₂ Lambda.step_code_case1_beta := by
  have h_subst_code : Primrec (fun p : ℕ × ℕ => subst_code p.1 0 p.2) := by
    have h_subst_code : Primrec (fun p : ℕ × ℕ × ℕ => subst_code p.1 p.2.1 p.2.2) := by
      exact Lambda.subst_code_primrec;
    exact h_subst_code.comp ( Primrec.fst.pair ( Primrec.const 0 |> Primrec.pair <| Primrec.snd ) );
