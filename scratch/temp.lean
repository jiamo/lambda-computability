/-
Addition of Church numerals is Lambda-computable.
-/
def Lambda.add : Lambda := Lambda.lam (Lambda.lam (Lambda.lam (Lambda.lam (Lambda.app (Lambda.app (Lambda.var 3) (Lambda.var 1)) (Lambda.app (Lambda.app (Lambda.var 2) (Lambda.var 1)) (Lambda.var 0))))))

theorem Lambda.add_works (n m : ℕ) : Lambda.reduces (Lambda.app (Lambda.app Lambda.add (Lambda.church n)) (Lambda.church m)) (Lambda.church (n + m)) := by
  -- Applying the definition of `add`, we get:
  have h1 : Lambda.reduces (Lambda.app (Lambda.app (Lambda.add) (Lambda.church n)) (Lambda.church m)) (Lambda.lam (Lambda.lam (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.app (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0))))) := by
    constructor;
    constructor;
    constructor;
    constructor;
    constructor;
    have h1 : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.app (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0))) (Lambda.iterate (Lambda.var 1) (Lambda.app (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0)) n) := by
      apply_rules [ Lambda.church_reduces_iterate ];
    apply_rules [ Lambda.reduces_lam, Lambda.reduces_app_left, Lambda.reduces_app_right ];
    induction' ( List.range n ) using List.reverseRecOn with n ih <;> aesop;
    · constructor;
    · -- By definition of substitution, we can rewrite the goal using the induction hypothesis.
      have h_subst : (Lambda.church m).subst 4 ((Lambda.var 1).app (List.foldl (fun t x => (Lambda.var 1).app t) (Lambda.var 0) n)) = (Lambda.var 1).app ((Lambda.church m).subst 4 (List.foldl (fun t x => (Lambda.var 1).app t) (Lambda.var 0) n)) := by
        simp [Lambda.subst]
      exact h_subst.symm ▸ Lambda.reduces_app_right a;
  -- Applying the definition of `Lambda.church`, we get:
  have h2 : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.app (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0))) (Lambda.iterate (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) m) n) := by
    -- Applying the definition of `Lambda.church`, we get the following reduction:
    have h3 : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0)) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) m) := by
      -- Apply the `Lambda.church_reduces_iterate` theorem with `f = Lambda.var 1` and `x = Lambda.var 0`.
      apply Lambda.church_reduces_iterate;
    -- Applying the definition of `Lambda.church`, we get the following reduction for the outer application:
    have h4 : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) m)) (Lambda.iterate (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) m) n) := by
      convert Lambda.church_reduces_iterate n ( Lambda.var 1 ) ( Lambda.iterate ( Lambda.var 1 ) ( Lambda.var 0 ) m ) using 1;
    -- Applying the transitivity of reductions:
    have h5 : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.app (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0))) (Lambda.app (Lambda.app (Lambda.church n) (Lambda.var 1)) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) m)) := by
      apply_rules [ Lambda.reduces_app_right ];
    have h6 : ∀ t1 t2 t3 : Lambda, t1.reduces t2 → t2.reduces t3 → t1.reduces t3 := by
      intros t1 t2 t3 h1 h2;
      induction h1 with
      | refl => assumption
      | step _ _ _ hs hr ih => exact Lambda.reduces.step _ _ _ hs (ih h2)
    exact h6 _ _ _ h5 h4;
  have h3 : Lambda.reduces (Lambda.lam (Lambda.lam (Lambda.iterate (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) m) n))) (Lambda.lam (Lambda.lam (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (n + m)))) := by
    apply_rules [ Lambda.reduces_lam, Lambda.reduces_lam ];
    -- Applying the definition of `Lambda.iterate`, we get by definition of `Lambda.iterate`:
    have h3 : Lambda.iterate (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) m) n = Lambda.iterate (Lambda.var 1) (Lambda.var 0) (n + m) := by
      rw [ Lambda.iterate_add ];
    rw [h3];
    constructor;
  -- By transitivity of reductions, we can combine h1, h2, and h3 to conclude the proof.
  have h_trans : Lambda.reduces (Lambda.app (Lambda.app (Lambda.add) (Lambda.church n)) (Lambda.church m)) (Lambda.lam (Lambda.lam (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (n + m)))) := by
    have h_trans : ∀ {t1 t2 t3 : Lambda}, Lambda.reduces t1 t2 → Lambda.reduces t2 t3 → Lambda.reduces t1 t3 := by
      intros t1 t2 t3 h1 h2;
      have h_trans : ∀ {t1 t2 t3 : Lambda}, Lambda.reduces t1 t2 → Lambda.reduces t2 t3 → Lambda.reduces t1 t3 := by
        intros t1 t2 t3 h1 h2
        exact (by
          have h_trans : ∀ {t1 t2 t3 : Lambda}, Lambda.reduces t1 t2 → Lambda.reduces t2 t3 → Lambda.reduces t1 t3 := by
            intros t1 t2 t3 h1 h2; exact (by
            induction h1 <;> tauto)
          exact h_trans h1 h2);
      exact h_trans h1 h2;
    exact h_trans h1 ( h_trans ( Lambda.reduces_lam ( Lambda.reduces_lam h2 ) ) h3 );
  convert h_trans using 1

/-
Definition of multiplication in Lambda calculus.
-/
def Lambda.mult : Lambda := Lambda.lam (Lambda.lam (Lambda.lam (Lambda.lam (Lambda.app (Lambda.app (Lambda.var 3) (Lambda.app (Lambda.var 2) (Lambda.var 1))) (Lambda.var 0)))))

/-
Helper lemma for multiplication: iterating the application of a Church numeral `n` times corresponds to iterating the base function `n * m` times.
-/
theorem Lambda.iterate_mul_term (n m : ℕ) :
  Lambda.reduces (Lambda.iterate (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0) n)
                 (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (n * m)) := by
                   induction' n with n ih;
                   · -- The base case when $n = 0$ simplifies both sides of the equation to the identity function.
                     simp [Lambda.iterate_zero];
                     constructor;
                   · -- By definition of iterate, we can split the reduction into two parts: reducing the first application and then the rest.
                     have h_split : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.iterate (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0) n)) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (m + n * m)) := by
                       have h_split : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.iterate (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0) n)) (Lambda.iterate (Lambda.var 1) (Lambda.iterate (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0) n) m) := by
                         apply_rules [ Lambda.church_reduces_iterate ];
                       have h_split : Lambda.reduces (Lambda.iterate (Lambda.var 1) (Lambda.iterate (Lambda.app (Lambda.church m) (Lambda.var 1)) (Lambda.var 0) n) m) (Lambda.iterate (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (n * m)) m) := by
                         have h_split : ∀ t t', Lambda.reduces t t' → ∀ m, Lambda.reduces (Lambda.iterate (Lambda.var 1) t m) (Lambda.iterate (Lambda.var 1) t' m) := by
                           intros t t' h m; induction' m with m ih generalizing t t' <;> simp_all +decide [ Lambda.iterate ] ;
                           simpa [ List.range_succ ] using Lambda.reduces_app_right ( ih t t' h );
                         exact h_split _ _ ih m;
                       have h_split : Lambda.reduces (Lambda.iterate (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (n * m)) m) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (m + n * m)) := by
                         rw [ Lambda.iterate_add ];
                         constructor;
                       -- By transitivity of reductions, we can combine the three reductions into one.
                       have h_trans : ∀ {t1 t2 t3 : Lambda}, Lambda.reduces t1 t2 → Lambda.reduces t2 t3 → Lambda.reduces t1 t3 := by
                         intros t1 t2 t3 h1 h2; exact (by
                         induction h1 <;> induction h2 <;> tauto);
                       exact h_trans ‹_› ( h_trans ‹_› ‹_› );
                     convert h_split using 1;
                     · rw [ Lambda.iterate_succ ];
                     · ring

/-
The constant zero function is Lambda-computable.
-/
def Lambda.zero_term : Lambda := Lambda.church 0

theorem LambdaComputable.zero : LambdaComputable (fun _ => Part.some 0) := by
  -- Define the function $F$ as $\lambda x. \lambda y. \lambda z. z$.
  use Lambda.lam (Lambda.lam (Lambda.lam (Lambda.var 0)));
  intro n m;
  constructor;
  · aesop;
    -- Let's simplify the goal using the definition of `Lambda.reduces`.
    constructor;
    constructor;
    constructor;
  · intro h;
    have := h;
    cases this;
    rename_i t₂ h₁ h₂;
    cases h₁;
    · unfold Lambda.church at *;
      induction m <;> simp_all +decide [ List.range_succ ];
      cases h₂;
      cases ‹ ( Lambda.var 0 ).lam.lam.step _ ›;
      cases ‹ ( Lambda.var 0 ).lam.step _ ›;
      cases ‹ ( Lambda.var 0 ).step _ ›;
    · cases ‹ ( Lambda.var 0 ).lam.lam.lam.step _›;
      cases ‹ ( Lambda.var 0 ).lam.lam.step _›;
      cases ‹ ( Lambda.var 0 ).lam.step _›;
      cases ‹ ( Lambda.var 0 ).step _›;
    · have := Lambda.church_normal n; aesop;
      cases this _ a


