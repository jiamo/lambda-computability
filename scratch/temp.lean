/-
Definition of closed terms: substitution has no effect.
-/
def Lambda.IsClosed (t : Lambda) : Prop := ∀ s x, Lambda.subst s x t = t

/-
Variables are not closed terms.
-/
theorem Lambda.IsClosed_var (n : ℕ) : ¬ Lambda.IsClosed (Lambda.var n) := by
  -- By definition of closed, if a term is closed, then substituting any term for any variable in it doesn't change it. For a variable term (var n), substituting any term for n would result in a different term. Therefore, var n cannot be closed.
  simp [Lambda.IsClosed];
  exact ⟨ var ( n + 1 ), n, by exact ne_of_apply_ne ( fun t => t ) ( by simp +decide [ Lambda.subst ] ) ⟩

