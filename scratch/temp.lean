/-
Iterating `pred_step` `n` times on `pred_init` reduces to `pair (n-1) n`.
-/
theorem Lambda.iterate_pred_step (n : ℕ) : Lambda.reduces (Lambda.iterate Lambda.pred_step Lambda.pred_init n) (Lambda.app (Lambda.app Lambda.pair (Lambda.church (n - 1))) (Lambda.church n)) := by
  induction' n with n ih;
  · simp [Lambda.iterate, Lambda.pred_init]; constructor
  · -- By definition of `iterate`, we have:
    have h_iter_succ : Lambda.iterate Lambda.pred_step Lambda.pred_init (n + 1) = Lambda.app Lambda.pred_step (Lambda.iterate Lambda.pred_step Lambda.pred_init n) := by
      exact Lambda.iterate_succ _ _ _
    have h_step : Lambda.reduces (Lambda.app Lambda.pred_step (Lambda.app (Lambda.app Lambda.pair (Lambda.church (n - 1))) (Lambda.church n))) (Lambda.app (Lambda.app Lambda.pair (Lambda.church n)) (Lambda.church (n + 1))) := by
      convert Lambda.pred_step_reduces ( n - 1 ) n using 1;
    aesop;
    have h_congr : ∀ {t1 t2 : Lambda}, Lambda.reduces t1 t2 → Lambda.reduces (Lambda.app Lambda.pred_step t1) (Lambda.app Lambda.pred_step t2) := by
      intros t1 t2 h; exact Lambda.reduces_app_right h
    exact h_congr ih |> Lambda.reduces_trans <| h_step

/-
`pred (church n)` reduces to `church (n-1)`.
-/
theorem Lambda.pred_works (n : ℕ) : Lambda.reduces (Lambda.app Lambda.pred (Lambda.church n)) (Lambda.church (n - 1)) := by
  have h_def : Lambda.reduces (Lambda.app Lambda.pred (Lambda.church n)) (Lambda.app Lambda.fst (Lambda.iterate Lambda.pred_step Lambda.pred_init n)) := by
    have h_def : Lambda.reduces (Lambda.app Lambda.pred (Lambda.church n)) (Lambda.app Lambda.fst (Lambda.app (Lambda.app (Lambda.church n) Lambda.pred_step) Lambda.pred_init)) := by
      have h_def : Lambda.pred = Lambda.lam (Lambda.app Lambda.fst (Lambda.app (Lambda.app (Lambda.var 0) Lambda.pred_step) Lambda.pred_init)) := rfl
      rw [h_def];
      constructor;
      constructor;
      simp [Lambda.subst, Lambda.fst, Lambda.pred_step, Lambda.pred_init, Lambda.pair, Lambda.succ, Lambda.snd, Lambda.church, Lambda.subst_church]; constructor
    have h_def : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) Lambda.pred_step) Lambda.pred_init) (Lambda.iterate Lambda.pred_step Lambda.pred_init n) := by
      apply_rules [ Lambda.church_reduces_iterate ];
    have h_trans : ∀ {t1 t2 t3 : Lambda}, Lambda.reduces t1 t2 → Lambda.reduces t2 t3 → Lambda.reduces t1 t3 := by
      intros t1 t2 t3 h1 h2; exact Lambda.reduces_trans h1 h2
    exact h_trans ‹_› (Lambda.reduces_app_right h_def)
  -- By definition of `fst`, we know that `fst (pair (church (n - 1)) (church n))` reduces to `church (n - 1)`.
  have h_fst : Lambda.reduces (Lambda.app Lambda.fst (Lambda.app (Lambda.app Lambda.pair (Lambda.church (n - 1))) (Lambda.church n))) (Lambda.church (n - 1)) := by
    apply_rules [ Lambda.fst_pair_church ];
  have h_iter : Lambda.reduces (Lambda.iterate Lambda.pred_step Lambda.pred_init n) (Lambda.app (Lambda.app Lambda.pair (Lambda.church (n - 1))) (Lambda.church n)) := by
    convert Lambda.iterate_pred_step n using 1;
  have h_trans : Lambda.reduces (Lambda.app Lambda.fst (Lambda.iterate Lambda.pred_step Lambda.pred_init n)) (Lambda.app Lambda.fst (Lambda.app (Lambda.app Lambda.pair (Lambda.church (n - 1))) (Lambda.church n))) := by
    exact Lambda.reduces_app_right h_iter
  exact Lambda.reduces_trans h_def ( Lambda.reduces_trans h_trans h_fst )

/-
`pred` is a closed term.
-/
theorem Lambda.pred_closed : Lambda.IsClosed Lambda.pred := by
  unfold Lambda.pred Lambda.fst Lambda.snd Lambda.pair Lambda.succ; intros s x; aesop;

/-
Iterating `pred` `m` times on `church n` yields `church (n-m)`.
-/
theorem Lambda.iterate_pred_works (n m : ℕ) : Lambda.reduces (Lambda.iterate Lambda.pred (Lambda.church n) m) (Lambda.church (n - m)) := by
  induction' m with m ih generalizing n <;> simp_all ( config := { decide := Bool.true } ) [ Lambda.iterate ];
  · constructor;
  · -- By the induction hypothesis, we know that `iterate pred (church n) m` reduces to `church (n - m)`.
    have h_ind : (List.foldl (fun t x => pred.app t) (church n) (List.range m)).reduces (church (n - m)) := by
      exact ih n;
    -- By the properties of the Church numerals and the predecessor function, we have that `pred.app (church (n - m))` reduces to `church ((n - m) - 1)`.
    have h_pred : (pred.app (church (n - m))).reduces (church ((n - m) - 1)) := by
      apply_rules [ Lambda.pred_works ];
    -- By the properties of the Church numerals and the predecessor function, we have that `pred.app (iterate pred (church n) m)` reduces to `pred.app (church (n - m))`.
    have h_pred_iter : (List.foldl (fun t x => pred.app t) (church n) (List.range (m + 1))).reduces (pred.app (church (n - m))) := by
      simp ( config := { decide := Bool.true } ) [ List.range_succ ];
      exact Lambda.reduces_app_right h_ind
    have h_eq : n - m - 1 = n - (m + 1) := by omega
    rw [h_eq] at h_pred
    exact Lambda.reduces_trans h_pred_iter h_pred

/-
`sub (church n) (church m)` reduces to `church (n - m)`.
-/
theorem Lambda.sub_works (n m : ℕ) : Lambda.reduces (Lambda.app (Lambda.app Lambda.sub (Lambda.church n)) (Lambda.church m)) (Lambda.church (n - m)) := by
  have h_sub_reduces : ∀ {t1 t2 t3 : Lambda}, Lambda.reduces t1 t2 → Lambda.reduces t2 t3 → Lambda.reduces t1 t3 := by
    intros t1 t2 t3 h1 h2; exact Lambda.reduces_trans h1 h2
  -- Apply the theorem that states the reduction of the application.
  apply h_sub_reduces;
  swap;
  apply Lambda.iterate_pred_works n m;
  constructor;
  constructor;
  constructor;
  constructor;
  constructor;
  convert Lambda.church_reduces_iterate _ _ _ using 1;
  congr! 2;
  -- Since substituting 0 into the church numeral doesn't change it, and substituting 0 into the church numeral of n also doesn't change it, the equality holds.
  simp [Lambda.subst];
  simp [Lambda.subst_church, Lambda.pred, Lambda.fst, Lambda.snd, Lambda.pair, Lambda.succ]

