/-
The successor function is Lambda-computable (assuming confluence).
-/
theorem LambdaComputable.succ (h_conf : Lambda.Confluence) : LambdaComputable (fun n => Part.some (n + 1)) := by
  -- Let's choose the term `F` to be `Lambda.succ`.
  use Lambda.succ;
  -- By definition of `Lambda.succ`, we know that `Lambda.succ` correctly increments a Church numeral.
  have h_succ : ∀ n, Lambda.reduces (Lambda.app Lambda.succ (Lambda.church n)) (Lambda.church (n + 1)) := by
    bound;
    -- Apply the hypothesis `h_succ` directly to conclude the proof.
    apply Lambda.succ_works;
  intro n m; specialize h_succ n; aesop;
  -- By the uniqueness of normal forms, if two terms reduce to the same normal form, they must be equal.
  have h_unique : ∀ t1 t2, Lambda.reduces t1 t2 → Lambda.is_normal t2 → ∀ t3, Lambda.reduces t1 t3 → Lambda.is_normal t3 → t2 = t3 := by
    intros t1 t2 ht1t2 ht2_normal t3 ht1t3 ht3_normal
    obtain ⟨t4, ht4⟩ := h_conf ht1t2 ht1t3
    have ht4_eq : t2 = t4 ∧ t3 = t4 := by
      exact ⟨ Lambda.reduces_normal_eq ht2_normal ht4.1, Lambda.reduces_normal_eq ht3_normal ht4.2 ⟩
    aesop;
  specialize h_unique _ _ h_succ ( Lambda.church_normal _ ) _ a ( Lambda.church_normal _ ) ; aesop;
  -- By the injectivity of `Lambda.church`, we have `n + 1 = m`.
  apply Lambda.church_injective h_unique

/-
Lambda computable functions are partial recursive (assuming evaluation correctness).
-/
theorem LambdaComputable_imp_Partrec (h_correct : Lambda.EvalCorrectness) {f : ℕ →. ℕ} (h : LambdaComputable f) : Partrec f := by
  obtain ⟨c, hc⟩ := LambdaComputable_imp_compute_fun_aux h_correct h
  have h_partrec : Partrec (Lambda.compute_fun c) := Lambda.compute_fun_partrec c
  have h_eq : f = Lambda.compute_fun c := by
    ext n
    rw [hc]
  rw [h_eq]
  exact h_partrec


