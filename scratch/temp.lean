theorem Lambda.body_code_primrec : Primrec Lambda.body_code := by
  unfold body_code;
  unfold app_code;
  -- The body_code function is a composition of primitive recursive functions: Nat.pair, Nat.rec, and the constant function Nat.pair 0 1.
  have h_body_code_primrec : Primrec (fun n => Nat.pair 1 (Nat.pair (Nat.pair 0 1) n)) := by
    -- The composition of primitive recursive functions is primitive recursive.
    have h_comp : Primrec (fun n => Nat.pair (Nat.pair 0 1) n) := by
      convert Primrec.pair ( Primrec.const _ ) Primrec.id;
      any_goals exact ℕ;
      any_goals try infer_instance;
      swap;
      exact Nat.pair 0 1;
      bound;
    exact Primrec.pair (Primrec.const 1) h_comp;
  convert Primrec.nat_rec _ _;
  rotate_left;
  exact ℕ;
  exact ℕ;
  all_goals try infer_instance;
  exact fun _ => Nat.pair 0 0;
  exact fun n => fun p => Nat.pair 1 ( Nat.pair ( Nat.pair 0 1 ) p.2 );
  · exact Primrec.const _;
  · exact h_body_code_primrec.comp ( Primrec.snd.comp ( Primrec.snd ) );
  · bound;
    · convert a.comp ( Primrec.snd ) using 1;
    · convert a.comp ( Primrec.id ) ( Primrec.id ) using 1

/-
`Lambda.church_code` encodes a Church numeral. It is primitive recursive.
-/
def Lambda.church_code (n : ℕ) : ℕ :=
