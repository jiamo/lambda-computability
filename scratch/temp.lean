/-
Addition is Lambda computable.
-/
theorem LambdaComputable2.add (h_conf : Lambda.Confluence) :
  LambdaComputable2 (fun n m => Part.some (n + m)) := by
    use Lambda.add; aesop;
    · subst_vars; exact Lambda.add_works _ _;
    · have := @Lambda.add_works n m;
      exact Lambda.unique_church_reduct h_conf this a

/-
Checking for existence of reduction lemmas for pred, sub, mult.
-/
#check Lambda.pred_works
#check Lambda.sub_works
#check Lambda.mult_works


/-
Multiplication is Lambda computable.
-/
theorem LambdaComputable2.mult (h_conf : Lambda.Confluence) :
  LambdaComputable2 (fun n m => Part.some (n * m)) := by
    constructor;
    -- By definition of `mult`, we know that `mult n m` reduces to `church (n * m)`.
    have h_mult : ∀ n m : ℕ, Lambda.reduces (Lambda.app (Lambda.app Lambda.mult (Lambda.church n)) (Lambda.church m)) (Lambda.church (n * m)) := by
      exact Lambda.mult_works;
    -- By definition of `mult`, we know that `mult n m` reduces to `church (n * m)` for any `n` and `m`.
    have h_mult_eq : ∀ n m k : ℕ, Lambda.reduces (Lambda.app (Lambda.app Lambda.mult (Lambda.church n)) (Lambda.church m)) (Lambda.church k) → n * m = k := by
      intros n m k h_mult_eq;
      apply_rules [ Lambda.unique_church_reduct ];
    exact fun n m k => ⟨ fun h => by simpa [ show n * m = k by simpa using h ] using h_mult n m, fun h => by simpa [ h_mult_eq n m k h ] ⟩

/-
Subtraction is Lambda computable.
-/
theorem LambdaComputable2.sub (h_conf : Lambda.Confluence) :
  LambdaComputable2 (fun n m => Part.some (n - m)) := by
    use Lambda.sub;
    intro n m k;
    constructor <;> intro hk;
    · norm_num +zetaDelta at *;
      rw [ ← hk ];
      exact Lambda.sub_works n m;
    · have := Lambda.unique_church_reduct h_conf hk ( Lambda.sub_works n m ) ; aesop;

/-
The predecessor function is Lambda computable.
-/
theorem LambdaComputable.pred (h_conf : Lambda.Confluence) :
  LambdaComputable (fun n => Part.some (n - 1)) := by
    constructor;
    -- To prove the equivalence, we split it into two implications.
    intro n m
    constructor;
    case w => exact Lambda.pred;
    · norm_num +zetaDelta at *;
      exact fun h => h ▸ Lambda.pred_works n;
    · intro h;
      have := Lambda.unique_church_reduct h_conf h ( Lambda.pred_works n ) ; aesop;

#check LambdaComputable.comp

#check Lambda.seq

/-
`church n` applied to `\z. t` and `t` reduces to `t` (for closed `t`).
-/
theorem Lambda.church_const_fun (n : ℕ) (t : Lambda) (ht : Lambda.IsClosed t) : Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) (Lambda.lam t)) t) t := by
  have := @Lambda.church_reduces_iterate;
  apply Lambda.reduces_trans;
  exact this n _ _;
  -- Since $t$ is closed, substituting $t$ into $t.lam$ results in $t.lam$.
  have h_subst : Lambda.subst t 0 (Lambda.lam t) = Lambda.lam t := by
    -- Since $t$ is closed, substituting $t$ into $t.lam$ results in $t.lam$ by definition of substitution.
    have h_subst : ∀ (s : Lambda) (x : ℕ), t.IsClosed → Lambda.subst s x t = t := by
      intros s x ht'; exact ht' s x;
    have h_subst_lam : ∀ (s : Lambda) (x : ℕ) (t : Lambda), t.IsClosed → Lambda.subst s x (Lambda.lam t) = Lambda.lam (Lambda.subst s (x + 1) t) := by
      intros s x t _; rfl;
    rw [ h_subst_lam _ _ _ ht, h_subst _ _ ht ];
  induction' n with n ih <;> simp_all +decide [ Lambda.iterate ];
  · constructor;
  · simp_all +decide [ List.range_succ ];
    -- Since $t$ is closed, substituting $t$ into $t.lam$ results in $t.lam$. Therefore, the application of $t.lam$ to the foldl result reduces to $t$.
    have h_subst : Lambda.reduces (Lambda.app (Lambda.lam t) (List.foldl (fun t_1 x => t.lam.app t_1) t (List.range n))) t := by
      have h_beta : ∀ t_1 : Lambda, Lambda.reduces (Lambda.app (Lambda.lam t) t_1) t := by
        intro t_1; exact (by
        constructor;
        constructor;
        -- Since $t$ is closed, substituting $t$ into $t_1$ results in $t$.
        have h_subst : ∀ t_1 : Lambda, t_1.subst 0 t = t := by
          intro t_1; exact Lambda.IsClosed_imp_subst_eq ht t_1 0;
        rw [ h_subst ];
        constructor)
      exact h_beta _;
    exact h_subst

/-
Definition of strict composition combinator.
-/
def Lambda.strict_comp (F G : Lambda) : Lambda :=
  Lambda.lam (Lambda.app (Lambda.app (Lambda.var 0) (Lambda.lam (Lambda.app (Lambda.lift 2 0 G) (Lambda.var 1)))) (Lambda.app (Lambda.lift 1 0 G) (Lambda.var 0)))

/-
Lifting a closed term does not change it.
-/
theorem Lambda.lift_closed {t : Lambda} (h : Lambda.IsClosed t) (n k : ℕ) : Lambda.lift n k t = t := by
  have h_lift_closed : ∀ (t : Lambda) (n k : ℕ), t.IsClosedAt k → lift n k t = t := by
    intro t n k ht;
    induction' t using Lambda.recOn with t ih generalizing k;
    · cases lt_or_ge t k <;> simp_all +decide [ Lambda.IsClosedAt ];
      · unfold Lambda.lift; aesop;
      · contrapose! ht;
        use var (t + 1), t;
        simp +decide [ *, Lambda.subst ];
    · simp_all +decide [ Lambda.IsClosedAt ];
      rw [ show lift n k ( ih.app _ ) = ( lift n k ih ).app ( lift n k _ ) by rfl ];
      congr;
      · apply_assumption;
        intro s x hx; specialize ht s x hx; unfold Lambda.subst at ht; aesop;
      · apply_assumption;
        intro s x hx; specialize ht s x hx; unfold Lambda.subst at ht; aesop;
    · simp_all! +decide [ Lambda.IsClosedAt ];
      rename_i h ih;
      exact ih ( k + 1 ) fun s x hx => by simpa using ht s ( x - 1 ) ( Nat.le_sub_one_of_lt hx ) |> fun h => by simpa [ Nat.sub_add_cancel ( show 1 ≤ x from Nat.pos_of_ne_zero ( by aesop_cat ) ) ] using h;
  exact h_lift_closed t n k ( fun s x _ => h s x )

/-
Definition of strict composition combinator (correct version).
-/
def Lambda.strict_comp_func (F G : Lambda) : Lambda :=
  Lambda.lam (Lambda.app (Lambda.lam (Lambda.app (Lambda.app (Lambda.var 0) (Lambda.lam (Lambda.app (Lambda.lift 2 0 G) (Lambda.var 1)))) (Lambda.app (Lambda.lift 1 0 G) (Lambda.var 0)))) (Lambda.app (Lambda.lift 1 0 F) (Lambda.var 0)))

#check Lambda.strict_comp

/-
Definitions for `seq_apply` and its components.
-/
def Lambda.seq_apply_inner (G : Lambda) : Lambda := Lambda.lam (Lambda.app (Lambda.lift 2 0 G) (Lambda.var 1))
def Lambda.seq_apply_arg (G : Lambda) : Lambda := Lambda.app (Lambda.lift 1 0 G) (Lambda.var 0)
def Lambda.seq_apply_body (G : Lambda) : Lambda := Lambda.app (Lambda.app (Lambda.var 0) (Lambda.seq_apply_inner G)) (Lambda.seq_apply_arg G)
def Lambda.seq_apply (G : Lambda) : Lambda := Lambda.lam (Lambda.seq_apply_body G)

/-
Substitution lemma for `seq_apply_inner` (corrected).
-/
theorem Lambda.subst_seq_apply_inner (G M : Lambda) (hG : Lambda.IsClosed G) :
  Lambda.subst M 0 (Lambda.seq_apply_inner G) = Lambda.lam (Lambda.app G M) := by
    unfold Lambda.seq_apply_inner;
    -- Since $G$ is closed, $lift 2 0 G = G$.
    have h_lift_closed : Lambda.lift 2 0 G = G := by
      -- Since `G` is closed, we can apply the lemma `lift_closed`.
      apply Lambda.lift_closed hG;
    -- By definition of substitution, we have:
    simp [h_lift_closed, Lambda.subst];
    exact hG M 1

/-
Substitution lemma for `seq_apply_arg`.
-/
theorem Lambda.subst_seq_apply_arg (G M : Lambda) (hG : Lambda.IsClosed G) :
  Lambda.subst M 0 (Lambda.seq_apply_arg G) = Lambda.app G M := by
    have h_subst_lift : Lambda.subst M 0 (Lambda.lift 1 0 G) = G := by
      have h_subst_lift : Lambda.lift 1 0 G = G := by
        exact Lambda.lift_closed hG 1 0;
      aesop;
    -- By definition of substitution, we know that substituting M into the app part of the expression replaces the variable 0 with M.
    have h_subst_app : Lambda.subst M 0 (Lambda.app (Lambda.lift 1 0 G) (Lambda.var 0)) = Lambda.app (Lambda.subst M 0 (Lambda.lift 1 0 G)) (Lambda.subst M 0 (Lambda.var 0)) := by
      rfl;
    exact h_subst_app.trans ( by rw [ h_subst_lift ] ; rfl )

/-
`seq_apply G M` reduces to `M (\z. G M) (G M)`.
-/
theorem Lambda.seq_apply_reduces (G M : Lambda) (hG : Lambda.IsClosed G) :
  Lambda.reduces (Lambda.app (Lambda.seq_apply G) M) (Lambda.app (Lambda.app M (Lambda.lam (Lambda.app G M))) (Lambda.app G M)) := by
    -- By definition of seq_apply, we have seq_apply G = lam (app (app (var 0) (seq_apply_inner G)) (seq_apply_arg G)).
    have h_seq_apply : Lambda.seq_apply G = Lambda.lam (Lambda.app (Lambda.app (Lambda.var 0) (Lambda.seq_apply_inner G)) (Lambda.seq_apply_arg G)) := by
      rfl;
    rw [h_seq_apply];
    -- Applying the beta reduction rule to the lambda expression.
    have h_beta : Lambda.reduces (Lambda.app (Lambda.lam (Lambda.app (Lambda.app (Lambda.var 0) (Lambda.seq_apply_inner G)) (Lambda.seq_apply_arg G))) M) (Lambda.subst M 0 (Lambda.app (Lambda.app (Lambda.var 0) (Lambda.seq_apply_inner G)) (Lambda.seq_apply_arg G))) := by
      constructor;
      constructor;
      constructor;
    -- By definition of substitution, we can rewrite the right-hand side of the equation.
    have h_subst : M.subst 0 (Lambda.app (Lambda.app (Lambda.var 0) (Lambda.seq_apply_inner G)) (Lambda.seq_apply_arg G)) = Lambda.app (Lambda.app M (Lambda.seq_apply_inner G |> Lambda.subst M 0)) (Lambda.seq_apply_arg G |> Lambda.subst M 0) := by
      simp [Lambda.subst];
    convert h_beta using 1;
    rw [ h_subst, Lambda.subst_seq_apply_inner, Lambda.subst_seq_apply_arg ] ; aesop;
    assumption

/-
Substitution lemma for `seq_apply_body`.
-/
theorem Lambda.subst_seq_apply_body (G M : Lambda) (hG : Lambda.IsClosed G) :
  Lambda.subst M 0 (Lambda.seq_apply_body G) = Lambda.app (Lambda.app M (Lambda.lam (Lambda.app G M))) (Lambda.app G M) := by
    -- Apply the definition of substitution to the expression.
    unfold Lambda.seq_apply_body;
    rw [Lambda.subst];
    rw [ Lambda.subst, Lambda.subst ];
    rw [ Lambda.subst_seq_apply_inner, Lambda.subst_seq_apply_arg ] ; aesop;
    · assumption;
    · assumption

/-
Definition of the composition term.
-/
def Lambda.comp_term (F G : Lambda) : Lambda :=
  Lambda.lam (Lambda.app (Lambda.seq_apply G) (Lambda.app (Lambda.lift 1 0 F) (Lambda.var 0)))

/-
`comp_term F G` applied to `n` reduces to `seq_apply G (F n)`.
-/
theorem Lambda.comp_term_reduces (F G : Lambda) (n : ℕ) (hF : Lambda.IsClosed F) (hG : Lambda.IsClosed G) :
  Lambda.reduces (Lambda.app (Lambda.comp_term F G) (Lambda.church n)) (Lambda.app (Lambda.seq_apply G) (Lambda.app F (Lambda.church n))) := by
    have h_comp_term_def : Lambda.reduces (Lambda.app (Lambda.lam (Lambda.app (Lambda.seq_apply G) (Lambda.app (Lambda.lift 1 0 F) (Lambda.var 0)))) (Lambda.church n)) (Lambda.app (Lambda.seq_apply G) (Lambda.app (Lambda.lift 1 0 F) (Lambda.church n))) := by
      constructor;
      constructor;
      -- Since the substitution of a closed term with another closed term is just the term itself, we can conclude that the substitution of (church n) into the app of seq_apply G and lift 1 0 F is equal to the app of seq_apply G and lift 1 0 F.
      have h_subst : Lambda.subst (Lambda.church n) 0 (Lambda.app (Lambda.seq_apply G) (Lambda.app (Lambda.lift 1 0 F) (Lambda.var 0))) = Lambda.app (Lambda.seq_apply G) (Lambda.app (Lambda.lift 1 0 F) (Lambda.church n)) := by
        unfold Lambda.subst;
        congr;
        · apply_rules [ Lambda.IsClosed_imp_subst_eq ];
          -- Since `G` is closed, the term `G.seq_apply` is also closed.
          have h_seq_apply_closed : G.IsClosed → (Lambda.lam (Lambda.app (Lambda.app (Lambda.var 0) (Lambda.lam (Lambda.app (Lambda.lift 2 0 G) (Lambda.var 1)))) (Lambda.app (Lambda.lift 1 0 G) (Lambda.var 0)))).IsClosed := by
            intros h s x; exact (by
            -- By definition of `subst`, we can rewrite the left-hand side of the equation using the fact that `G` is closed.
            have h_subst : Lambda.lift 2 0 G = G ∧ Lambda.lift 1 0 G = G := by
              exact ⟨ by rw [ Lambda.lift_closed hG ], by rw [ Lambda.lift_closed hG ] ⟩;
            simp +decide [ h_subst, Lambda.subst ];
            exact ⟨ h _ _, h _ _ ⟩);
          exact h_seq_apply_closed hG;
        · -- Since `F` is closed, `lift 1 0 F` is just `F`.
          have h_lift_F : Lambda.lift 1 0 F = F := by
            exact Lambda.lift_closed hF 1 0;
          unfold Lambda.subst; aesop;
      exact h_subst ▸ by constructor;
    convert h_comp_term_def using 1;
    rw [ Lambda.lift_closed hF ]

