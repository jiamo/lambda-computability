theorem eval_ecf_mk_var_ecf (s_code y x : ℕ) :
  eval_ecf (mk_var_ecf s_code y) x = if x = y then s_code else Lambda.var_code y := by
    unfold eval_ecf mk_var_ecf at * ; aesop;
    grind +ring

theorem eval_ecf_mk_app_ecf (f g : ECF) (x : ℕ) :
  eval_ecf (mk_app_ecf f g) x = Lambda.app_code (eval_ecf f x) (eval_ecf g x) := by
    simp +decide [ mk_app_ecf, eval_ecf ];
    grind

theorem eval_ecf_mk_lam_ecf (f : ECF) (x : ℕ) :
  eval_ecf (mk_lam_ecf f) x = Lambda.lam_code (eval_ecf f (x + 1)) := by
    unfold mk_lam_ecf eval_ecf; aesop;
    · omega;
    · linarith

theorem Lambda.subst_code'_eq_eval_subst_ecf (s_code t_code x : ℕ) :
  Lambda.subst_code' s_code t_code x = eval_ecf (Lambda.subst_ecf s_code t_code) x := by
    -- We proceed by induction on `t_code`.
    induction' t_code using Nat.strong_induction_on with t_code ih generalizing s_code x;
    -- Split into cases based on the unpairing of t_code.
    by_cases h : t_code = 0 ∨ t_code.unpair.1 = 0 ∨ t_code.unpair.1 = 1 ∨ t_code.unpair.1 = 2;
    · unfold subst_code' subst_ecf;
      rw [ Nat.strongRecOn_eq, Nat.strongRecOn_eq ];
      rcases h with ( rfl | h | h | h ) <;> simp +decide [ * ];
      · unfold eval_ecf mk_var_ecf; simp +decide [ Nat.unpair ] ;
        unfold var_code; aesop;
      · unfold eval_ecf mk_var_ecf; simp +decide [ * ] ;
        cases h' : Nat.unpair t_code ; aesop;
        · rw [ List.getElem_append ] ; aesop;
          · rw [ ← Nat.pair_unpair t_code, h' ];
            rfl;
          · omega;
        · rw [ ← Nat.pair_unpair t_code, h' ] ; rfl;
      · rcases h' : Nat.unpair t_code with ⟨ a, b ⟩ ; aesop;
        rw [ eval_ecf_mk_app_ecf ];
        congr;
        · convert ih _ _ _ _ using 1;
          rw [ Nat.unpair ] at h' ; aesop;
          · exact lt_of_le_of_lt ( Nat.unpair_left_le _ ) ( by nlinarith [ Nat.sub_add_cancel ( Nat.sqrt_le t_code ) ] );
          · exact lt_of_le_of_lt ( Nat.unpair_left_le _ ) ( by omega );
        · convert ih _ _ _ _ using 1;
          rw [ ← Nat.pair_unpair t_code ] ; aesop;
          rw [ Nat.pair ];
          aesop;
          · nlinarith [ Nat.unpair_right_le b ];
          · interval_cases b <;> trivial;
      · rw [ show Nat.unpair t_code = ( 2, t_code.unpair.2 ) from Prod.ext h rfl ];
        rw [ eval_ecf_mk_lam_ecf ];
        norm_num +zetaDelta at *;
        congr;
        convert ih _ _ _ _ using 1;
        have := Nat.unpair_right_le t_code; aesop;
        cases lt_or_eq_of_le this <;> aesop;
        rw [ Nat.unpair ] at * ; aesop;
        · rw [ Nat.sub_eq_zero_of_le ] at h <;> nlinarith;
        · omega;
    · rw [ Lambda.subst_code', Lambda.subst_ecf ];
      rw [ Nat.strongRecOn_eq, Nat.strongRecOn_eq ];
      aesop

theorem Lambda.subst_code_uncurried_primrec : Primrec Lambda.subst_code_uncurried := by
  rw [Primrec]
  let f : (ℕ × ℕ × ℕ) → ECF := fun v => Lambda.subst_ecf v.1 v.2.1
  let g : (ℕ × ℕ × ℕ) → ℕ := fun v => v.2.2
  have hf : Primrec f := Lambda.subst_ecf_primrec.comp Primrec.fst (Primrec.fst.comp Primrec.snd)
  have hg : Primrec g := Primrec.snd.comp Primrec.snd
  have : Lambda.subst_code_uncurried = fun v => eval_ecf (f v) (g v) := by
    funext v
    simp only [Lambda.subst_code_uncurried, f, g]
    rw [Lambda.subst_code'_eq_eval_subst_ecf]
  rw [this]
  exact eval_ecf_primrec.comp hf hg

