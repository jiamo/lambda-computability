/-
`eval_ecf` is primitive recursive.
-/
def ECF := List ℕ × ℕ

instance : Primcodable ECF := inferInstanceAs (Primcodable (List ℕ × ℕ))

def eval_ecf (f : ECF) (x : ℕ) : ℕ :=
  if x < f.1.length then f.1[x]! else f.2

theorem eval_ecf_primrec : Primrec₂ eval_ecf := by
  unfold eval_ecf;
  -- The function `List.getElem!` is primitive recursive, so we can use it directly.
  have h_get!_primrec : Primrec (fun (x : (List ℕ × ℕ) × ℕ) => if x.2 < x.1.1.length then x.1.1[x.2]! else x.1.2) := by
    have h_get : Primrec (fun (x : (List ℕ × ℕ) × ℕ) => if x.2 < x.1.1.length then x.1.1[x.2]? else Option.none) := by
      have h_get : Primrec (fun (x : (List ℕ × ℕ) × ℕ) => x.1.1[x.2]?) := by
        have h_get? : Primrec (fun (x : List ℕ × ℕ) => x.1[x.2]?) := by
          norm_num +zetaDelta at *;
          -- The function List.getElem? is primitive recursive because it can be defined using the primitive recursive function List.getElem?.
          apply Primrec.list_getElem?
        convert h_get? |> Primrec.comp <| Primrec.fst |> Primrec.pair <| Primrec.snd using 1;
        bound;
        exact a.comp ( Primrec.fst.comp ( Primrec.fst ) |> Primrec.pair <| Primrec.snd );
      convert h_get using 1;
      ext; aesop;
      grind;
    have h_get!_primrec : Primrec (fun (x : (List ℕ × ℕ) × ℕ) => (if x.2 < x.1.1.length then x.1.1[x.2]? else Option.none).getD x.1.2) := by
      convert Primrec.option_getD.comp _ _;
      · exact h_get;
      · exact Primrec.snd.comp ( Primrec.fst );
    simp +zetaDelta at *;
    grind;
  exact h_get!_primrec

