    have h_pair_primrec : Primrec₂ Nat.pair := by
      apply Primrec₂.natPair;
    exact h_pair_primrec.comp ( Primrec.const _ ) ( h_pair_primrec.comp ( Primrec.const _ ) ( Primrec.id ) );
  convert h_composition.comp ( Lambda.body_code_primrec ) using 1

/-
The encoding of the Church numeral for `n` is equal to `Lambda.church_code n`.
-/
theorem Lambda.encode_church_eq_church_code (n : ℕ) : Lambda.encode (Lambda.church n) = Lambda.church_code n := by
  -- Since the application is already in the form of a pair, the encoding of the application is trivially equal to the encoding of the Church numeral.
  simp [Lambda.app_code, Lambda.body_code, Lambda.church_code];
  -- By definition of encode, we can expand the right-hand side.
  simp [church, Lambda.encode];
  induction n <;> simp_all +decide [ List.range_succ ];
  rw [ ← ‹ ( List.foldl ( fun t x => ( var 1 ).app t ) ( var 0 ) ( List.range _ ) ).encode = Nat.rec ( Nat.pair 0 0 ) ( fun x c => Nat.pair 1 ( Nat.pair ( Nat.pair 0 1 ) c ) ) _ › ];
  rfl

