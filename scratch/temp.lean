/-
`Lambda.unbody_code c` returns `some n` if and only if `c` is the code for the body of the Church numeral `n`.
-/
theorem Lambda.unbody_code_eq_some_iff (c n : ℕ) : Lambda.unbody_code c = some n ↔ c = Lambda.body_code n := by
  constructor;
  · induction' n with n ih generalizing c;
    · intro hc;
      unfold Lambda.unbody_code at hc;
      rw [ Nat.strongRecOn_eq ] at hc ; aesop;
    · -- By definition of `unbody_code`, if `unbody_code c = some (n + 1)`, then `c` must be of the form `app (var 1) (body_code n)`.
      intro h
      have h_app : c = Nat.pair 1 (Nat.pair (Nat.pair 0 1) (body_code n)) := by
        unfold unbody_code at h;
        rw [ Nat.strongRecOn_eq ] at h;
        split_ifs at h ; norm_num at h;
        rcases h' : Nat.unpair c with ⟨ _ | _ | a, b ⟩ <;> simp_all +decide;
        rw [ h' ] at h; simp +decide at h;
        have := ih ( Nat.unpair b |>.2 ) h.2; aesop;
        rw [ ← Nat.pair_unpair c, h' ];
        rw [ ← left, ← this ];
        rw [ Nat.pair_unpair ];
      exact h_app;
  · exact fun h => h ▸ Lambda.unbody_code_correct n

/-
`Lambda.unchurch_code c` returns `some n` if and only if `c` is the code for the Church numeral `n`.
-/
theorem Lambda.unchurch_code_eq_some_iff (c n : ℕ) : Lambda.unchurch_code c = some n ↔ c = Lambda.church_code n := by
  constructor <;> intro h;
  · unfold Lambda.unchurch_code at h;
    unfold church_code;
    cases h' : Nat.unpair c ; aesop;
    rw [ show c = Nat.pair ( Nat.unpair c |>.1 ) ( Nat.unpair c |>.2 ) by rw [ Nat.pair_unpair ] ] ; aesop;
    rw [ show c1_body_1 = body_code n from by { have := unbody_code_eq_some_iff c1_body_1 n; aesop } ] at heq_1 ; rw [ ← Nat.pair_unpair snd, heq_1 ];
  · exact h ▸ Lambda.unchurch_code_correct n

/-
Helper definitions and lemmas for `Lambda.iterate`.
-/
def Lambda.iterate (f x : Lambda) (n : ℕ) : Lambda :=
  (List.range n).foldl (fun t _ => Lambda.app f t) x

theorem Lambda.iterate_zero (f x : Lambda) : Lambda.iterate f x 0 = x := rfl

theorem Lambda.iterate_succ (f x : Lambda) (n : ℕ) : Lambda.iterate f x (n + 1) = Lambda.app f (Lambda.iterate f x n) := by
  -- By definition of `iterate`, we have `f.iterate x (n + 2) = f.app (f.iterate x (n + 1))`.
  simp [Lambda.iterate, Nat.add_comm, Nat.add_left_comm];
  simp +decide [ List.range_succ ]

theorem Lambda.church_eq_iterate (n : ℕ) : Lambda.church n = Lambda.lam (Lambda.lam (Lambda.iterate (Lambda.var 1) (Lambda.var 0) n)) := rfl

/-
Substitution distributes over `Lambda.iterate`.
-/
theorem Lambda.subst_iterate (s : Lambda) (k : ℕ) (f x : Lambda) (n : ℕ) :
  Lambda.subst s k (Lambda.iterate f x n) = Lambda.iterate (Lambda.subst s k f) (Lambda.subst s k x) n := by
    unfold Lambda.iterate;
    induction' n with n ih generalizing x <;> simp_all +decide [ List.range_succ ];
    rw [ ← ih, Lambda.subst ]

/-
`Lambda.church n` applied to `f` and `x` reduces to `iterate (subst x 0 f) x n`.
-/
theorem Lambda.church_reduces_iterate (n : ℕ) (f x : Lambda) :
  Lambda.reduces (Lambda.app (Lambda.app (Lambda.church n) f) x) (Lambda.iterate (Lambda.subst x 0 f) x n) := by
    -- Apply the beta reduction to the first application.
    have h1 : Lambda.reduces (Lambda.app (Lambda.lam (Lambda.lam (Lambda.iterate (Lambda.var 1) (Lambda.var 0) n))) f) (Lambda.lam (Lambda.iterate (Lambda.subst f 1 (Lambda.var 1)) (Lambda.subst f 1 (Lambda.var 0)) n)) := by
      -- Apply the beta reduction rule to the app of the lam and f, then use the substitution property.
      apply Lambda.reduces.step;
      constructor;
      -- By definition of substitution, we can rewrite the left-hand side to match the right-hand side.
      have h_subst : Lambda.subst f 0 (Lambda.lam (Lambda.iterate (Lambda.var 1) (Lambda.var 0) n)) = Lambda.lam (Lambda.subst f 1 (Lambda.iterate (Lambda.var 1) (Lambda.var 0) n)) := by
        simp [Lambda.subst];
      -- By definition of substitution, we can rewrite the left-hand side to match the right-hand side using the fact that `subst` is compatible with `lam`.
      have h_subst_iterate : Lambda.subst f 1 (Lambda.iterate (Lambda.var 1) (Lambda.var 0) n) = Lambda.iterate (Lambda.subst f 1 (Lambda.var 1)) (Lambda.subst f 1 (Lambda.var 0)) n := by
        exact Lambda.subst_iterate f 1 (Lambda.var 1) (Lambda.var 0) n;
      aesop;
      constructor;
    -- Apply the beta reduction to the second application.
    have h2 : Lambda.reduces (Lambda.app (Lambda.lam (Lambda.iterate (Lambda.subst f 1 (Lambda.var 1)) (Lambda.subst f 1 (Lambda.var 0)) n)) x) (Lambda.iterate (Lambda.subst x 0 (Lambda.subst f 1 (Lambda.var 1))) (Lambda.subst x 0 (Lambda.subst f 1 (Lambda.var 0))) n) := by
      -- Apply the beta reduction rule to the application of the lambda term to x.
      have h2 : Lambda.reduces (Lambda.app (Lambda.lam (Lambda.iterate (Lambda.subst f 1 (Lambda.var 1)) (Lambda.subst f 1 (Lambda.var 0)) n)) x) (Lambda.subst x 0 (Lambda.iterate (Lambda.subst f 1 (Lambda.var 1)) (Lambda.subst f 1 (Lambda.var 0)) n)) := by
        exact Lambda.reduces.step _ _ _ (Lambda.step.beta _ _) (Lambda.reduces.refl _);
      convert h2 using 1;
      exact (Lambda.subst_iterate x 0 (Lambda.subst f 1 (Lambda.var 1)) (Lambda.subst f 1 (Lambda.var 0)) n).symm;
    have h_trans : ∀ t₁ t₂ t₃, Lambda.reduces t₁ t₂ → Lambda.reduces (Lambda.app t₂ x) t₃ → Lambda.reduces (Lambda.app t₁ x) t₃ := by
      intros t₁ t₂ t₃ h₁ h₂;
      induction h₁ <;> aesop;
      exact Lambda.reduces.step _ _ _ ( Lambda.step.app_left _ _ _ a ) a_ih;
    exact h_trans _ _ _ h1 h2

