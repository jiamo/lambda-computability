theorem Lambda.pred_zero : Lambda.reduces (Lambda.app Lambda.pred (Lambda.church 0)) (Lambda.church 0) := by
  -- By definition of `pred`, we have `pred.app (church 0) = app (fst) (app (app (church 0) (app (app pair (app snd (var 0))) (app succ (app snd (var 0))))) (app (app pair (church 0)) (church 0)))`.
  simp [Lambda.pred];
  -- By definition of `fst`, we have `fst.app (pair (church 0) (church 0)) = church 0`.
  simp [Lambda.fst];
  -- By definition of `pair`, we have `pair (church 0) (church 0) = lam (lam (app (app (var 0) (var 2)) (var 1)))`.
  simp [Lambda.pair];
  repeat' constructor;
  repeat' constructor;

