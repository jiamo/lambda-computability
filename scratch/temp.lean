/-
Alternative definition of `lt` using `not'`.
-/
def Lambda.lt' : Lambda := Lambda.lam (Lambda.lam (Lambda.app Lambda.not' (Lambda.app (Lambda.app Lambda.leq (Lambda.var 0)) (Lambda.var 1))))

/-
`lt'` correctly computes the less-than relation.
-/
theorem Lambda.lt'_works (n m : ℕ) :
  Lambda.reduces (Lambda.app (Lambda.app Lambda.lt' (Lambda.church n)) (Lambda.church m))
    (if n < m then Lambda.true else Lambda.false) := by
      -- By definition of `lt'`, we have `lt' n m = not' (leq m n)`.
      have h_lt_def : Lambda.reduces (Lambda.app (Lambda.app Lambda.lt' (Lambda.church n)) (Lambda.church m)) (Lambda.app Lambda.not' (Lambda.app (Lambda.app Lambda.leq (Lambda.church m)) (Lambda.church n))) := by
        constructor;
        constructor;
        constructor;
        norm_num [ Lambda.subst ];
        -- By definition of `subst`, we know that `subst (church n) 1 not'` is just `not'` since `church n` is closed.
        have h_subst : Lambda.subst (Lambda.church n) 1 Lambda.not' = Lambda.not' := by
          have : Lambda.IsClosed Lambda.not' := by unfold Lambda.IsClosed; aesop;
          exact this _ _;
        -- By definition of `subst`, we know that `subst (church n) 1 leq` is just `leq` since `church n` is closed.
        have h_subst_leq : Lambda.subst (Lambda.church n) 1 Lambda.leq = Lambda.leq := by
          have : Lambda.IsClosed Lambda.leq := by unfold Lambda.IsClosed; aesop;
          exact this _ _
        aesop;
        constructor;
        constructor;
        -- By definition of `subst`, we know that `subst (church m) 0 not'` is just `not'` since `church m` is closed.
        have h_subst_not' : Lambda.subst (Lambda.church m) 0 Lambda.not' = Lambda.not' := by
          have : Lambda.IsClosed Lambda.not' := by unfold Lambda.IsClosed; aesop;
          exact this _ _;
        -- By definition of `subst`, we know that `subst (church m) 0 (leq.app (var 0))` is just `leq.app (church m)` since `church m` is closed.
        have h_subst_leq_app : Lambda.subst (Lambda.church m) 0 (Lambda.app (Lambda.leq) (Lambda.var 0)) = Lambda.app (Lambda.leq) (Lambda.church m) := by
          have hcl : Lambda.IsClosed Lambda.leq := by unfold Lambda.IsClosed; aesop;
          simp [Lambda.subst]; exact hcl _ _;
        -- By definition of `subst`, we know that `subst (church m) 0 (not'.app ((leq.app (var 0)).app (church n)))` is just `not'.app ((leq.app (church m)).app (church n))` since `church m` is closed.
        have h_subst_not'_app : Lambda.subst (Lambda.church m) 0 (Lambda.app Lambda.not' (Lambda.app (Lambda.leq.app (Lambda.var 0)) (Lambda.church n))) = Lambda.app Lambda.not' (Lambda.app (Lambda.leq.app (Lambda.church m)) (Lambda.church n)) := by
          -- By definition of `subst`, we know that `subst (church m) 0 (not'.app ((leq.app (var 0)).app (church n)))` is just `not'.app ((leq.app (church m)).app (church n))` since `church m` is closed. This follows from the fact that substitution in the application of two terms is the application of the substitutions.
          have h_subst_not'_app : ∀ t1 t2 : Lambda, Lambda.subst (Lambda.church m) 0 (Lambda.app t1 t2) = Lambda.app (Lambda.subst (Lambda.church m) 0 t1) (Lambda.subst (Lambda.church m) 0 t2) := by
            aesop;
          aesop;
          -- By definition of `subst`, we know that `subst (church m) 0 (church n)` is just `church n` since `church m` is closed.
          apply Lambda.subst_church;
        exact h_subst_not'_app.symm ▸ by constructor;
      -- By definition of `leq`, we have `leq m n` reduces to `true` if `m ≤ n` and `false` otherwise.
      have h_leq : Lambda.reduces (Lambda.app (Lambda.app Lambda.leq (Lambda.church m)) (Lambda.church n)) (if m ≤ n then Lambda.true else Lambda.false) := by
        exact Lambda.leq_works m n;
      -- By definition of `not'`, we have `not' true` reduces to `false` and `not' false` reduces to `true`.
      have h_not : Lambda.reduces (Lambda.app Lambda.not' Lambda.true) Lambda.false ∧ Lambda.reduces (Lambda.app Lambda.not' Lambda.false) Lambda.true := by
        exact ⟨ Lambda.not'_true, Lambda.not'_false ⟩;
      -- By transitivity of reduction, we can combine the reductions from `h_lt_def` and `h_leq` to conclude the proof.
      have h_trans : Lambda.reduces (Lambda.app Lambda.not' (Lambda.app (Lambda.app Lambda.leq (Lambda.church m)) (Lambda.church n))) (Lambda.app Lambda.not' (if m ≤ n then Lambda.true else Lambda.false)) := by
        exact Lambda.reduces_app_right h_leq;
      -- By transitivity of reduction, we can combine the reductions from `h_lt_def`, `h_trans`, and `h_not` to conclude the proof.
      have h_final : Lambda.reduces (Lambda.app (Lambda.app Lambda.lt' (Lambda.church n)) (Lambda.church m)) (if m ≤ n then Lambda.false else Lambda.true) := by
        bound;
        all_goals first | exact Lambda.reduces_trans h_lt_def ( Lambda.reduces_trans h_trans left ) | exact Lambda.reduces_trans h_lt_def ( Lambda.reduces_trans h_trans right ) | exact absurd h_1 ( by linarith );
      split_ifs at * <;> simp_all +decide [ not_le_of_gt ]

