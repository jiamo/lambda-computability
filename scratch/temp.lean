/-
Definition of normal order reduction step for Lambda terms.
-/
def Lambda.step_normal : Lambda → Option Lambda
  | Lambda.var _ => none
  | Lambda.lam t => (Lambda.step_normal t).map Lambda.lam
  | Lambda.app t1 t2 =>
    match t1 with
    | Lambda.lam t1_body => some (Lambda.subst t2 0 t1_body)
    | _ =>
      match Lambda.step_normal t1 with
      | some t1' => some (Lambda.app t1' t2)
      | none =>
        match Lambda.step_normal t2 with
        | some t2' => some (Lambda.app t1 t2')
        | none => none

/-
Equivalence between code-based reduction step and term-based normal order reduction step.
-/
theorem Lambda.code_step'_eq_step_normal (t : Lambda) :
  Lambda.code_step' (Lambda.encode t) = (Lambda.step_normal t).map Lambda.encode := by
    have h_eq_step : ∀ t : Lambda, Lambda.code_step' (Lambda.encode t) = Option.map Lambda.encode (Lambda.step_normal t) := by
      intro t;
      induction' t using Lambda.recOn with t ih t ih t1 t2 ih1 ih2;
      · unfold code_step';
        unfold step_normal; aesop;
        unfold Lambda.encode;
        unfold step_code'; aesop;
        rw [ Nat.strongRecOn_eq ];
        rw [ Nat.unpair_pair ] ; aesop;
      · unfold Lambda.step_normal; aesop;
        · convert Lambda.code_step'_beta t1_body t using 1;
        · rw [ Lambda.code_step'_app_left ] <;> aesop;
        · rw [ Lambda.code_step'_app_right ] <;> aesop;
        · rw [ code_step'_app_none ] <;> aesop;
      · -- By definition of `code_step'`, we know that `code_step' (encode (lam t2))` is the code of the result of applying the step relation to `lam t2`.
        have h_code_step_lam : Lambda.code_step' (Lambda.encode (Lambda.lam t2)) = Option.map Lambda.encode (Lambda.step_normal (Lambda.lam t2)) := by
          have h_step_lam : Lambda.step_normal (Lambda.lam t2) = Option.map Lambda.lam (Lambda.step_normal t2) := by
            rfl
          simp_all +decide [ Lambda.encode ];
          unfold code_step';
          rw [ Nat.strongRecOn_eq ];
          unfold step_code'; aesop;
          rw [ step_code_case2 ];
          rw [ List.length_map, List.length_range ] ; aesop;
          · unfold code_step' at ih1; aesop;
            bound;
            cases h : t2.step_normal <;> aesop;
            · unfold step_code' at ih1; aesop;
            · unfold step_code' at ih1; aesop;
          · unfold code_step' at ih1; aesop;
            unfold step_code' at * ; aesop;
          · rw [ Nat.pair ] at h ; norm_num at h;
            split_ifs at h <;> nlinarith;
        exact h_code_step_lam;
    exact h_eq_step t

/-
Definition of normal order evaluation for Lambda terms.
-/
def Lambda.eval_normal (t : Lambda) : Part Lambda :=
  PFun.fix (fun t => Part.some (match Lambda.step_normal t with | some t' => Sum.inl t' | none => Sum.inr t)) t

/-
Correct definition of normal order evaluation (iterated reduction until normal form).
-/
def Lambda.eval_norm (t : Lambda) : Part Lambda :=
  PFun.fix (fun t => Part.some (match Lambda.step_normal t with | some t' => Sum.inr t' | none => Sum.inl t)) t

/-
Definition of the step iteration function for normal order reduction, and its correspondence to the code-based step iteration.
-/
def Lambda.step_iter_norm (t : Lambda) : Lambda ⊕ Lambda :=
  match Lambda.step_normal t with
  | some t' => Sum.inr t'
  | none => Sum.inl t

theorem Lambda.step_iter'_eq_step_iter_norm (t : Lambda) :
  Lambda.step_iter' (Lambda.encode t) = (Lambda.step_iter_norm t).map Lambda.encode Lambda.encode := by
    have := @Lambda.code_step'_eq_step_normal;
    unfold step_iter' step_iter_norm at * ; aesop;

