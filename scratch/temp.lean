theorem Lambda.isZero_zero : Lambda.reduces (Lambda.app Lambda.isZero (Lambda.church 0)) Lambda.true := by
  constructor;
  constructor;
  -- By definition of `church`, we know that `church 0` is the identity function.
  have h_church0 : Lambda.church 0 = Lambda.lam (Lambda.lam (Lambda.var 0)) := by
    rfl;
  -- The identity function applied to any argument is just the argument itself.
  simp [h_church0, Lambda.subst];
  constructor;
  constructor;
  constructor;
  constructor;
  constructor;
  constructor

/-
`isZero` applied to `church (n+1)` reduces to `false`.
-/
theorem Lambda.isZero_succ (n : ℕ) : Lambda.reduces (Lambda.app Lambda.isZero (Lambda.church (n + 1))) Lambda.false := by
  cases' n with n n;
  · repeat constructor;
  · -- By definition of `church`, we have `church (n + 2) = Lambda.lam (Lambda.lam (Lambda.app (Lambda.var 1) (Lambda.iterate (Lambda.var 1) (Lambda.var 0) (n + 1))))`.
    rw [Lambda.church];
    -- By definition of `iter`, we have `iter (var 1) (var 0) (n + 1) = (var 1) (iter (var 1) (var 0) n)`.
    have h_iter : List.foldl (fun t x => (var 1).app t) (var 0) (List.range (n + 2)) = (var 1).app (List.foldl (fun t x => (var 1).app t) (var 0) (List.range (n + 1))) := by
      simp +decide [ List.range_succ ];
    aesop;
    repeat constructor;


